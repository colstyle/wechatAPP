# ===== 小时光租衣舍 — 环境配置模板 =====
# 使用说明：
#   cp .env.example .env       → 本地开发
#   cp .env.example .env.test  → 测试环境（填写测试服务器值）
#   生产环境通过服务器环境变量或 CI/CD Secret 注入，不创建 .env.prod 文件
#
# ⚠️  .env 和 .env.prod 已加入 .gitignore，绝不提交到代码仓库
# ✅  .env.example 和 .env.test（无真实密钥）可以提交

# ===== 环境标识 =====
APP_ENV=dev                         # dev | test | prod

# ===== 应用配置 =====
APP_NAME=小时光租衣舍
APP_VERSION=1.0.0
DEBUG=True                          # prod 环境必须改为 False

# ===== 数据库配置 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=                        # 必填，无默认值
DB_NAME=celestial_dev               # dev:celestial_dev / test:celestial_test / prod:celestial_prod

# ===== JWT 配置 =====
JWT_SECRET_KEY=                     # 必填，无默认值，生产请使用随机高强度字符串（openssl rand -hex 32）
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080            # 7天 = 60*24*7

# ===== 微信小程序配置 =====
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# ===== 微信支付配置（v1.1 接入时填写）=====
WECHAT_PAY_MCH_ID=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_APIV3_KEY=

# ===== AI 配置 =====
AI_SERVICE_TYPE=deepseek            # deepseek | gemini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=

# ===== CORS 配置 =====
# dev/test 用 ["*"]，prod 必须改为 ["https://servicewechat.com"]
CORS_ORIGINS=["*"]

# ===== TTLock 智能锁（v1.2 对接时填写）=====
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_ACCESS_TOKEN=