# ===== 小时光租衣舍 — 测试环境配置 (Test Env) =====
# 提示：本文件包含的是测试环境的示例与占位信息，无任何真实生产密钥，可提交至 Git。
# 在真实部署的测试服务器上，请使用有效的密钥覆盖。

# ===== 环境标识 =====
APP_ENV=test

# ===== 应用配置 =====
APP_NAME=小时光租衣舍(测试版)
APP_VERSION=1.0.0
DEBUG=True

# ===== 数据库配置 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# 测试环境数据库密码占位（实际部署测试环境时，请覆盖）
DB_PASSWORD=test_db_password
DB_NAME=celestial_test

# ===== JWT 配置 =====
# 测试用 JWT Secret（固定且不安全，切勿用于生产）
JWT_SECRET_KEY=test_jwt_secret_key_placeholder_123456
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ===== 微信小程序配置 =====
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# ===== 微信支付配置（空）=====
WECHAT_PAY_MCH_ID=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_APIV3_KEY=

# ===== AI 配置 (空) =====
AI_SERVICE_TYPE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=

# ===== CORS 配置 =====
CORS_ORIGINS=["*"]

# ===== TTLock 智能锁（空）=====
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_ACCESS_TOKEN=
