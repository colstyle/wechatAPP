/* app.wxss */
page {
  --primary-color: #ff6b6b;
  --secondary-color: #ff8787;
  --success-color: #51cf66;
  --warning-color: #ffd93d;
  --danger-color: #ff6348;
  --info-color: #4dabf7;
  --light-color: #f8f9fa;
  --dark-color: #212529;
  --gray-100: #f8f9fa;
  --gray-200: #e9ecef;
  --gray-300: #dee2e6;
  --gray-400: #ced4da;
  --gray-500: #adb5bd;
  --gray-600: #6c757d;
  --gray-700: #495057;
  --gray-800: #343a40;
  --gray-900: #212529;
  --border-radius: 8px;
  --box-shadow: 0 2px 12px rgba(0,0,0,0.1);

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: var(--gray-900);
  background-color: var(--gray-100);
}

/* 通用样式 */
.container {
  padding: 0 24rpx;
}

.card {
  background: #fff;
  border-radius: var(--border-radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--box-shadow);
}

.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.justify-between {
  justify-content: space-between;
}

.items-center {
  align-items: center;
}

.flex-wrap {
  flex-wrap: wrap;
}

/* 按钮样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: var(--border-radius);
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  transition: all 0.3s;
}

.btn-primary {
  background: var(--primary-color);
  color: #fff;
}

.btn-primary:hover {
  background: var(--secondary-color);
}

.btn-outline {
  border: 1rpx solid var(--primary-color);
  color: var(--primary-color);
}

.btn-outline:hover {
  background: var(--primary-color);
  color: #fff;
}

.btn-success {
  background: var(--success-color);
  color: #fff;
}

.btn-danger {
  background: var(--danger-color);
  color: #fff;
}

.btn-block {
  width: 100%;
  margin-bottom: 16rpx;
}

.btn-sm {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.btn-lg {
  padding: 24rpx 48rpx;
  font-size: 32rpx;
}

/* 输入框样式 */
.input {
  padding: 16rpx;
  border: 1rpx solid var(--gray-300);
  border-radius: var(--border-radius);
  font-size: 28rpx;
  transition: border-color 0.3s;
}

.input:focus {
  border-color: var(--primary-color);
}

/* 图片样式 */
.img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.img-circle {
  border-radius: 50%;
}

.img-thumbnail {
  border: 2rpx solid var(--gray-200);
  border-radius: var(--border-radius);
  padding: 2rpx;
}

/* 文字样式 */
.text-primary {
  color: var(--primary-color);
}

.text-success {
  color: var(--success-color);
}

.text-warning {
  color: var(--warning-color);
}

.text-danger {
  color: var(--danger-color);
}

.text-info {
  color: var(--info-color);
}

.text-muted {
  color: var(--gray-600);
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-left {
  text-align: left;
}

.text-sm {
  font-size: 24rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-xl {
  font-size: 40rpx;
}

.text-bold {
  font-weight: bold;
}

/* 边距 */
.m-0 { margin: 0; }
.m-1 { margin: 8rpx; }
.m-2 { margin: 16rpx; }
.m-3 { margin: 24rpx; }
.m-4 { margin: 32rpx; }

.mt-0 { margin-top: 0; }
.mt-1 { margin-top: 8rpx; }
.mt-2 { margin-top: 16rpx; }
.mt-3 { margin-top: 24rpx; }
.mt-4 { margin-top: 32rpx; }

.mb-0 { margin-bottom: 0; }
.mb-1 { margin-bottom: 8rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mb-4 { margin-bottom: 32rpx; }

.ml-0 { margin-left: 0; }
.ml-1 { margin-left: 8rpx; }
.ml-2 { margin-left: 16rpx; }
.ml-3 { margin-left: 24rpx; }
.ml-4 { margin-left: 32rpx; }

.mr-0 { margin-right: 0; }
.mr-1 { margin-right: 8rpx; }
.mr-2 { margin-right: 16rpx; }
.mr-3 { margin-right: 24rpx; }
.mr-4 { margin-right: 32rpx; }

/* 填充 */
.p-0 { padding: 0; }
.p-1 { padding: 8rpx; }
.p-2 { padding: 16rpx; }
.p-3 { padding: 24rpx; }
.p-4 { padding: 32rpx; }

.pt-0 { padding-top: 0; }
.pt-1 { padding-top: 8rpx; }
.pt-2 { padding-top: 16rpx; }
.pt-3 { padding-top: 24rpx; }
.pt-4 { padding-top: 32rpx; }

.pb-0 { padding-bottom: 0; }
.pb-1 { padding-bottom: 8rpx; }
.pb-2 { padding-bottom: 16rpx; }
.pb-3 { padding-bottom: 24rpx; }
.pb-4 { padding-bottom: 32rpx; }

.pl-0 { padding-left: 0; }
.pl-1 { padding-left: 8rpx; }
.pl-2 { padding-left: 16rpx; }
.pl-3 { padding-left: 24rpx; }
.pl-4 { padding-left: 32rpx; }

.pr-0 { padding-right: 0; }
.pr-1 { padding-right: 8rpx; }
.pr-2 { padding-right: 16rpx; }
.pr-3 { padding-right: 24rpx; }
.pr-4 { padding-right: 32rpx; }

/* 间距 */
.gap-0 { gap: 0; }
.gap-1 { gap: 8rpx; }
.gap-2 { gap: 16rpx; }
.gap-3 { gap: 24rpx; }
.gap-4 { gap: 32rpx; }

/* 布局布局 */
.grid {
  display: grid;
}

.grid-2 {
  grid-template-columns: repeat(2, 1fr);
}

.grid-3 {
  grid-template-columns: repeat(3, 1fr);
}

.grid-4 {
  grid-template-columns: repeat(4, 1fr);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--gray-200);
  margin: 24rpx 0;
}

.divider-vertical {
  width: 1rpx;
  background: var(--gray-200);
  margin: 0 24rpx;
}

/* 徽章 */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: bold;
}

.badge-primary {
  background: var(--primary-color);
  color: #fff;
}

.badge-success {
  background: var(--success-color);
  color: #fff;
}

.badge-warning {
  background: var(--warning-color);
  color: #333;
}

.badge-danger {
  background: var(--danger-color);
  color: #fff;
}

/* 加载动画 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.loading::after {
  content: "";
  display: inline-block;
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--gray-300);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--gray-500);
}

/* 价格样式 */
.price {
  font-weight: bold;
  color: var(--danger-color);
}

.price::before {
  content: '¥';
  font-size: 0.8em;
}

.price::after {
  content: '';
  font-size: 0.7em;
}

.price-small {
  font-size: 28rpx;
}

.price-large {
  font-size: 40rpx;
}

.price-line {
  text-decoration: line-through;
  color: var(--gray-500);
  font-size: 0.8em;
  margin-left: 16rpx;
}

/* 评分样式 */
.rating {
  display: flex;
  align-items: center;
}

.rating-star {
  color: var(--warning-color);
  font-size: 32rpx;
}

.rating-star.empty {
  color: var(--gray-300);
}

.rating-text {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: var(--gray-600);
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.tag-primary {
  background: var(--primary-color);
  color: #fff;
}

.tag-success {
  background: var(--success-color);
  color: #fff;
}

.tag-warning {
  background: var(--warning-color);
  color: #333;
}

.tag-danger {
  background: var(--danger-color);
  color: #fff;
}

/* 卡片布局 */
.product-card {
  background: #fff;
  border-radius: var(--border-radius);
  overflow: hidden;
  box-shadow: var(--box-shadow);
}

.product-image {
  width: 100%;
  height: 400rpx;
}

.product-info {
  padding: 16rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-price {
  font-size: 32rpx;
  color: var(--danger-color);
  font-weight: bold;
}

.product-price::before {
  content: '¥';
  font-size: 0.8em;
}

.product-price-small {
  font-size: 24rpx;
}

/* 导航栏 */
.nav-bar {
  background: #fff;
  padding: 16rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
}

.nav-search {
  padding: 12rpx 24rpx;
  background: var(--gray-100);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
}

.nav-search-icon {
  color: var(--gray-400);
  margin-right: 16rpx;
}

.nav-search-input {
  flex: 1;
  font-size: 28rpx;
}

/* 底部操作栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 24rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.1);
  z-index: 1000;
}

.footer-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer-price {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--danger-color);
}

.footer-price::before {
  content: '¥';
  font-size: 0.8em;
}

.footer-button {
  padding: 16rpx 48rpx;
  border-radius: 32rpx;
  font-size: 32rpx;
  font-weight: 500;
}

/* 遮罩层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: none;
}

.mask.show {
  display: block;
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal.hide {
  display: none;
}

.modal-content {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  width: 100%;
  padding: 32rpx;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: var(--gray-100);
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  margin: 16rpx;
}

.search-icon {
  color: var(--gray-400);
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

/* 选项卡 */
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid var(--gray-200);
}

.tab {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
  position: relative;
}

.tab.active {
  color: var(--primary-color);
  font-weight: 500;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: var(--primary-color);
  border-radius: 2rpx;
}

/* 列表 */
.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--gray-200);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-content {
  flex: 1;
}

.list-item-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.list-item-subtitle {
  font-size: 24rpx;
  color: var(--gray-500);
}

.list-item-extra {
  font-size: 24rpx;
  color: var(--gray-600);
}

/* 头像 */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--gray-200);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-sm {
  width: 48rpx;
  height: 48rpx;
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx;
}

/* 统计数据 */
.stat {
  text-align: center;
  padding: 24rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.stat-label {
  font-size: 24rpx;
  color: var(--gray-500);
  margin-top: 8rpx;
}