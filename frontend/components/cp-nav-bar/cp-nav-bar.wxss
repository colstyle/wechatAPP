/* components/cp-nav-bar/cp-nav-bar.wxss */

.nav-bar-wrap {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  box-sizing: border-box;
  transition: background 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
}

.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px; /* 标准微信导航栏内容区高度 */
  padding: 0 8px;
}

/* 返回按钮区 */
.nav-btn-group {
  width: 88px;
  display: flex;
  align-items: center;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(10px);
}

/* 纯 CSS 箭头 - 极简线条风格 */
.nav-icon-back {
  width: 20rpx;
  height: 20rpx;
  border-left: 3rpx solid #1C1C1C;
  border-bottom: 3rpx solid #1C1C1C;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.nav-icon-back.light {
  border-color: #FFFFFF;
}

.nav-btn-placeholder {
  width: 88rpx;
}

/* 标题区 */
.nav-title-wrap {
  flex: 1;
  text-align: center;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 1px;
  color: #1C1C1C;
}

.nav-title.light {
  color: #FFFFFF;
  font-weight: 300;
}
