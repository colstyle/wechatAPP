/* components/cp-empty/cp-empty.wxss */

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  text-align: center;
}

.has-padding {
  padding-top: 200rpx;
}

.icon-box {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 高奢文件夹图标 */
.luxury-folder {
  position: relative;
  width: 90rpx;
  height: 70rpx;
  z-index: 2;
}
.folder-back {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #E8E5DF;
  border-radius: 8rpx;
  transform: skewX(-5deg);
}
.folder-front {
  position: absolute;
  top: 10rpx; left: -5rpx; right: 5rpx; bottom: -5rpx;
  background: #FFF;
  border: 2rpx solid #E8E5DF;
  border-radius: 8rpx;
  transform: skewX(-5deg);
  display: flex;
  flex-direction: column;
  padding: 12rpx;
  gap: 8rpx;
  box-shadow: 4rpx 4rpx 12rpx rgba(0,0,0,0.02);
}
.folder-line { height: 4rpx; background: rgba(197, 160, 89, 0.2); border-radius: 2rpx; width: 80%; }
.folder-line.short { width: 50%; }

.pulse-ring {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 140rpx;
  height: 140rpx;
  border: 2rpx solid rgba(197, 160, 89, 0.1);
  border-radius: 50%;
  animation: pulse 3s infinite;
}

@keyframes pulse {
  0% { transform: translate(-50%, -50%) scale(0.8); opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(1.4); opacity: 0; }
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1C;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 26rpx;
  color: #B0A99A;
  line-height: 1.6;
}

.action-btn {
  margin-top: 60rpx;
  background: #1C1C1C;
  color: #FFF;
  font-size: 26rpx;
  font-weight: 500;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
}
