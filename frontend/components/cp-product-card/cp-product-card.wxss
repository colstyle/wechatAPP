/* components/cp-product-card/cp-product-card.wxss */

/* 卡片根容器 */
.card-root {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(28, 28, 28, 0.06);
  position: relative;
}

/* 图片容器 - 强制 3:4 比例 */
.img-wrap {
  position: relative;
  width: 100%;
  padding-bottom: 133.33%; /* 3:4 aspect ratio */
  background: #F5F4F0;
  overflow: hidden;
}

.img-cover {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 0.3s ease;
}
.img-cover.img-loaded {
  opacity: 1;
}

/* 骨架屏 Shimmer */
.img-skeleton {
  position: absolute;
  inset: 0;
  background: #EEECE8;
}

@keyframes shimmer {
  0%   { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}

.shimmer {
  background: linear-gradient(
    90deg,
    #EEECE8 25%,
    #E8E5E0 50%,
    #EEECE8 75%
  );
  background-size: 800rpx 100%;
  animation: shimmer 1.4s ease-in-out infinite;
}

/* 套餐角标 */
.badge-wrap {
  position: absolute;
  top: 16rpx;
  left: 0;
}
.badge-pkg {
  background: #C5A059;
  color: #FFF;
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 16rpx 4rpx 12rpx;
  border-radius: 0 20rpx 20rpx 0;
  letter-spacing: 1px;
}

/* 热门/新品角标 */
.badge-status-wrap {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  display: flex;
  gap: 8rpx;
}
.badge-status {
  font-size: 18rpx;
  font-weight: 600;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}
.badge-status.hot {
  background: rgba(176, 91, 91, 0.85);
  color: #FFF;
}
.badge-status.new {
  background: rgba(142, 151, 117, 0.85);
  color: #FFF;
}

/* 已定出遮罩 */
.rented-overlay {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(2px);
}
.rented-tag {
  background: rgba(28, 28, 28, 0.7);
  color: #FFF;
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 36rpx;
  border-radius: 8rpx;
  letter-spacing: 2px;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

/* 信息区 */
.info-wrap {
  padding: 16rpx 18rpx 20rpx;
}

.name {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #1C1C1C;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 价格行 */
.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 10rpx;
}

.price-main {
  display: flex;
  align-items: baseline;
}
.price-unit {
  font-size: 20rpx;
  color: #C5A059;
  font-weight: 500;
}
.price-num {
  font-size: 32rpx;
  color: #C5A059;
  font-weight: 600;
  line-height: 1;
  margin: 0 2rpx;
}
.price-day {
  font-size: 20rpx;
  color: #8E9775;
  font-weight: 400;
}
.price-deposit {
  font-size: 20rpx;
  color: #B0A99A;
}
