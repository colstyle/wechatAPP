/* pages/detail/detail.wxss */

/* === 页面根 === */
.page-root {
  min-height: 100vh;
  background: #FDFCF9;
}

/* === 骨架屏 === */
@keyframes shimmer {
  0%   { background-position: -600rpx 0; }
  100% { background-position: 600rpx 0; }
}
.shimmer {
  background: linear-gradient(90deg, #EEECE8 25%, #E2DED8 50%, #EEECE8 75%);
  background-size: 1200rpx 100%;
  animation: shimmer 1.4s ease-in-out infinite;
}
.skeleton-wrap {}
.sk-hero {
  width: 100%;
  height: 880rpx;
}
.sk-body {
  padding: 32rpx;
}
.sk-line {
  border-radius: 8rpx;
  display: block;
  height: 28rpx;
}

/* === ① 沉浸式轮播 === */
.hero-swiper-wrap {
  position: relative;
  width: 100%;
}
.hero-swiper {
  width: 100%;
  height: 880rpx;
}
.hero-img {
  width: 100%;
  height: 100%;
}

/* 悬浮返回按钮 */
.hero-back {
  position: absolute;
  top: 0;
  left: 0;
  padding: 60rpx 28rpx 20rpx; /* 让出状态栏空间 */
  z-index: 10;
}
.icon-back-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-arrow-left {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid #1C1C1C;
  border-bottom: 3rpx solid #1C1C1C;
  transform: rotate(45deg);
  margin-left: 6rpx;
}

/* 图片计数 */
.hero-count {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  background: rgba(0, 0, 0, 0.46);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #FFF;
}
.icon-img-sm {
  width: 28rpx;
  height: 22rpx;
  border: 2rpx solid rgba(255,255,255,0.8);
  border-radius: 4rpx;
}

/* === ② 信息区 === */
.content-wrap {
  background: #FDFCF9;
  border-radius: 32rpx 32rpx 0 0;
  margin-top: -32rpx;
  padding: 36rpx 32rpx 0;
  position: relative;
  z-index: 1;
}

.name-row {
  margin-bottom: 24rpx;
}
.product-name {
  font-size: 38rpx;
  font-weight: 600;
  color: #1C1C1C;
  line-height: 1.3;
  display: block;
}
.tag-list {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}
.tag {
  font-size: 20rpx;
  font-weight: 500;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  letter-spacing: 0.5px;
}
.tag.hot    { background: rgba(176,91,91,0.1);  color: #B05B5B; }
.tag.new    { background: rgba(142,151,117,0.15); color: #6E7A58; }
.tag.brand  { background: rgba(197,160,89,0.12); color: #9A7B3A; }

/* === 价格卡 === */
.price-card {
  display: flex;
  align-items: stretch;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(28,28,28,0.04);
}
.price-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.price-item.main { border: none; }
.p-divider {
  width: 1rpx;
  background: rgba(28,28,28,0.06);
  margin: 0 8rpx;
}
.p-label {
  font-size: 20rpx;
  color: #B0A99A;
  margin-bottom: 8rpx;
}
.p-val-wrap {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}
.p-unit        { font-size: 20rpx; color: #C5A059; font-weight: 500; }
.p-num         { font-size: 40rpx; color: #C5A059; font-weight: 700; line-height: 1; }
.p-sub         { font-size: 20rpx; color: #C5A059; }
.p-num.small   { font-size: 32rpx; color: #1C1C1C; }
.p-unit.small  { color: #6B6660; }
.p-num.neutral { font-size: 32rpx; color: #8E9775; }
.p-hint        { font-size: 18rpx; color: #C0BBB4; margin-top: 4rpx; }

/* === 规格选择 === */
.spec-section {
  margin-bottom: 28rpx;
}
.spec-label {
  font-size: 22rpx;
  color: #B0A99A;
  margin-bottom: 16rpx;
  font-weight: 500;
  letter-spacing: 0.5px;
}
.spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.spec-chip {
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #6B6660;
  background: #FFFFFF;
  border: 1.5rpx solid rgba(28,28,28,0.1);
  transition: all 0.18s;
}
.spec-chip.active {
  background: rgba(197,160,89,0.1);
  border-color: #C5A059;
  color: #9A7B3A;
  font-weight: 500;
}

.color-opts { gap: 12rpx; }
.color-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  border: 1.5rpx solid rgba(28,28,28,0.08);
  background: #FFFFFF;
  font-size: 24rpx;
  color: #6B6660;
}
.color-chip.active {
  border-color: #C5A059;
  background: rgba(197,160,89,0.08);
}
.color-swatch {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(28,28,28,0.12);
  flex-shrink: 0;
}
.color-label { font-size: 24rpx; }

/* === 商品描述 === */
.desc-section { margin-bottom: 28rpx; }
.sec-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1C;
  margin-bottom: 16rpx;
}
.desc-text {
  font-size: 26rpx;
  color: #8E877F;
  line-height: 1.7;
}
.detail-img {
  width: 100%;
  display: block;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
}

/* === ③ 磨砂底部操作栏 === */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  border-top: 1rpx solid rgba(28,28,28,0.06);
}
.glass {
  background: rgba(253, 252, 249, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}
.bottom-bar-inner {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  gap: 24rpx;
}
.bar-action-btns {
  display: flex;
  gap: 8rpx;
}
.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: rgba(28,28,28,0.04);
}
/* 纯 CSS 首页小图标 */
.icon-home-sm {
  width: 30rpx;
  height: 28rpx;
  border: 2.5rpx solid #8E9775;
  border-radius: 0 0 5rpx 5rpx;
  border-top: none;
  position: relative;
  margin-bottom: 2rpx;
}
.icon-home-sm::before {
  content: '';
  position: absolute;
  top: -14rpx;
  left: -6rpx;
  right: -6rpx;
  height: 1rpx;
  border-left: 21rpx solid transparent;
  border-right: 21rpx solid transparent;
  border-bottom: 14rpx solid #8E9775;
}
/* 纯 CSS 客服气泡图标 */
.icon-chat-sm {
  width: 30rpx;
  height: 28rpx;
  border: 2.5rpx solid #8E9775;
  border-radius: 8rpx;
  position: relative;
  margin-bottom: 2rpx;
}
.icon-chat-sm::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 8rpx;
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-top: 8rpx solid #8E9775;
}
.action-label {
  font-size: 18rpx;
  color: #8E9775;
  margin-top: 2rpx;
}
.bar-cta {
  flex: 1;
}
.cta-btn {
  height: 88rpx;
  background: #1C1C1C;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cta-text {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 500;
  letter-spacing: 2px;
}

/* === 遮罩 === */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 200;
  visibility: hidden;
  transition: background 0.3s;
}
.mask.show {
  background: rgba(0, 0, 0, 0.5);
  visibility: visible;
}

/* === ④ 租赁底部弹窗 === */
.rental-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FDFCF9;
  border-radius: 40rpx 40rpx 0 0;
  z-index: 201;
  padding: 0 32rpx 0;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}
.rental-sheet.show {
  transform: translateY(0);
}

.sheet-handle {
  width: 60rpx;
  height: 6rpx;
  background: rgba(28,28,28,0.12);
  border-radius: 999rpx;
  margin: 20rpx auto 24rpx;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1C;
  margin-bottom: 28rpx;
  text-align: center;
}

/* 租赁方案卡 */
.rental-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.rental-card {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
  border-radius: 20rpx;
  border: 1.5rpx solid rgba(28,28,28,0.08);
  background: #FFFFFF;
  position: relative;
  transition: all 0.2s;
}
.rental-card.active {
  border-color: #C5A059;
  background: rgba(197,160,89,0.05);
}
.rc-lead { flex: 1; }
.rc-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1C1C1C;
  display: block;
}
.rc-desc {
  font-size: 22rpx;
  color: #B0A99A;
  display: block;
  margin-top: 4rpx;
}
.rc-price {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  margin-right: 20rpx;
}
.rc-unit { font-size: 20rpx; color: #C5A059; }
.rc-num  { font-size: 36rpx; color: #C5A059; font-weight: 600; }
.rc-day  { font-size: 20rpx; color: #B0A99A; }
/* 选中勾 - 纯 CSS */
.rc-check {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(28,28,28,0.1);
  display: none;
}
.rc-check.show {
  display: block;
  background: #C5A059;
  border-color: #C5A059;
  position: relative;
}
.rc-check.show::after {
  content: '';
  position: absolute;
  top: 5rpx;
  left: 9rpx;
  width: 7rpx;
  height: 13rpx;
  border-right: 2rpx solid #FFF;
  border-bottom: 2rpx solid #FFF;
  transform: rotate(45deg);
}

/* 天数选择 */
.days-section { margin-bottom: 24rpx; }
.days-label {
  font-size: 22rpx;
  color: #B0A99A;
  margin-bottom: 16rpx;
  display: block;
}
.days-options {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.day-chip {
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  border: 1.5rpx solid rgba(28,28,28,0.1);
  background: #FFFFFF;
  font-size: 24rpx;
  color: #6B6660;
  display: flex;
  align-items: center;
}
.day-chip.active {
  background: #1C1C1C;
  border-color: #1C1C1C;
  color: #FFFFFF;
}
.day-custom-wrap { margin-top: 16rpx; }
.day-input {
  width: 100%;
  height: 72rpx;
  background: #F5F3EF;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 费用汇总 */
.fee-summary {
  padding: 24rpx 0 20rpx;
  border-top: 1rpx solid rgba(28,28,28,0.06);
  margin-bottom: 20rpx;
}
.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.fee-row.total { margin-top: 16rpx; }
.fee-label { font-size: 24rpx; color: #8E877F; }
.fee-label-total { font-size: 26rpx; color: #1C1C1C; font-weight: 500; }
.fee-val { font-size: 26rpx; color: #1C1C1C; }
.fee-val.muted { color: #B0A99A; }
.fee-divider { height: 1rpx; background: rgba(28,28,28,0.06); margin: 8rpx 0; }
.fee-total-wrap { display: flex; align-items: baseline; gap: 4rpx; }
.fee-unit { font-size: 22rpx; color: #C5A059; }
.fee-total { font-size: 48rpx; color: #C5A059; font-weight: 700; }

/* 确认按钮 */
.sheet-btn {
  height: 96rpx;
  background: #1C1C1C;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 500;
  letter-spacing: 3px;
  margin-bottom: 20rpx;
}
