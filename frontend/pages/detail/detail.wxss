/* pages/detail/detail.wxss */
.page {
  padding-bottom: 120rpx;
  background-color: #f8f9fa;
}

/* 模拟图标 */
.iconfont {
  font-family: serif;
}
.icon-heart::before { content: '♡'; }
.icon-heart-fill::before { content: '❤'; }
.icon-home::before { content: '🏠'; }
.icon-service::before { content: '💬'; }
.icon-star::before { content: '⭐'; }

/* 加载动画容器 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 80vh;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #ff6b6b;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
.image-swiper {
  width: 100%;
  height: 750rpx;
  background-color: #fff;
}

.product-image {
  width: 100%;
  height: 100%;
}

/* 商品基本信息 */
.product-info {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.product-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.product-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
}

.product-favorite {
  padding: 10rpx;
}

.icon-heart, .icon-heart-fill {
  font-size: 44rpx;
  color: #999;
}

.icon-heart-fill.active {
  color: #ff6b6b;
}

.product-tags {
  margin-top: 15rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 10rpx;
}

.tag-hot { background: #fff5f5; color: #ff6b6b; border: 1rpx solid #ff6b6b; }
.tag-new { background: #f0f9eb; color: #51cf66; border: 1rpx solid #51cf66; }

/* 价格区块 */
.product-price-box {
  margin-top: 30rpx;
  background: #fff9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  flex-wrap: wrap;
}

.price-row {
  width: 50%;
  display: flex;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.price-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 10rpx;
}

.price {
  font-size: 32rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.deposit-row {
  width: 100%;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #ffdada;
}

.deposit {
  color: #333;
}

/* 统计数据 */
.product-stats {
  margin-top: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  margin: 0 30rpx;
  color: #eee;
}

/* 通用区块样式 */
.section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 25rpx;
  display: flex;
  align-items: center;
}

/* 规格选择 */
.size-options, .color-options {
  display: flex;
  flex-wrap: wrap;
}

.size-option {
  padding: 12rpx 30rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.size-option.active {
  background: #fff5f5;
  color: #ff6b6b;
  border-color: #ff6b6b;
}

.color-option {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
}

.color-option.active {
  background: #fff5f5;
  border-color: #ff6b6b;
}

.color-dot {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  border: 1rpx solid #eee;
}

.color-name {
  font-size: 26rpx;
  color: #666;
}

.color-option.active .color-name {
  color: #ff6b6b;
}

/* 商品详情描述 */
.product-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 搭配推荐 */
.outfit-scroll {
  white-space: nowrap;
}

.outfit-card {
  display: inline-block;
  width: 240rpx;
  margin-right: 20rpx;
}

.outfit-img {
  width: 240rpx;
  height: 320rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.outfit-name {
  display: block;
  font-size: 24rpx;
  color: #333;
  margin-top: 10rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 评价部分 */
.more-link {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

.review-summary {
  display: flex;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.rating-overview {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-right: 40rpx;
  border-right: 1rpx solid #eee;
}

.rating-score {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff9900;
}

.rating-label {
  font-size: 20rpx;
  color: #999;
}

.rating-bars {
  flex: 1;
  padding-left: 40rpx;
}

.rating-bar {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.bar-label {
  font-size: 20rpx;
  color: #999;
  width: 50rpx;
}

.bar-track {
  flex: 1;
  height: 8rpx;
  background: #eee;
  border-radius: 4rpx;
  margin: 0 15rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #ff9900;
  border-radius: 4rpx;
}

.bar-count {
  font-size: 20rpx;
  color: #ccc;
  width: 40rpx;
}

.review-item {
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.review-user {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 15rpx;
  background: #f5f5f5;
}

.user-name {
  font-size: 26rpx;
  color: #333;
}

.review-rating {
  margin-bottom: 10rpx;
}

.icon-star {
  font-size: 24rpx;
  color: #ff9900;
  margin-right: 4rpx;
}

.icon-star.empty {
  color: #eee;
}

.review-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.review-images {
  margin-top: 15rpx;
  display: flex;
  flex-wrap: wrap;
}

.review-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 15rpx;
  margin-bottom: 15rpx;
}

.review-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

.no-reviews {
  text-align: center;
  padding: 40rpx 0;
  color: #ccc;
  font-size: 26rpx;
}

/* 底部操作栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom);
}

.footer-left {
  display: flex;
  flex: 0 0 200rpx;
  margin-right: 20rpx;
}

.footer-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 20rpx;
  color: #666;
}

.footer-btn .iconfont {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.footer-right {
  flex: 1;
  display: flex;
  min-width: 0;
}

.footer-btn-main {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  padding: 0;
  margin: 0;
  min-width: 0;
}

/* 弹窗遮罩 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 200;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.mask.show {
  opacity: 1;
  visibility: visible;
}

/* 租赁弹窗 */
.rental-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  z-index: 201;
  transform: translateY(100%);
  transition: all 0.3s;
  padding: 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.rental-modal.show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  padding: 10rpx;
}

.rental-type {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
}

.rental-type.active {
  background: #fff5f5;
  border-color: #ff6b6b;
}

.rental-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.rental-desc {
  font-size: 26rpx;
  color: #ff6b6b;
}

.days-selector {
  margin-top: 30rpx;
}

.days-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.days-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.day-option {
  padding: 10rpx 25rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.day-option.active {
  background: #ff6b6b;
  color: #fff;
}

.days-custom {
  margin-top: 20rpx;
}

.days-input {
  background: #f5f5f5;
  padding: 15rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.price-calculation {
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #f5f5f5;
  text-align: right;
}

.calc-label {
  font-size: 24rpx;
  color: #999;
}

.calc-price {
  font-size: 28rpx;
  color: #333;
  margin-right: 20rpx;
}

.calc-total {
  font-size: 40rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.modal-footer {
  margin-top: 40rpx;
}

.btn-block {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
}
