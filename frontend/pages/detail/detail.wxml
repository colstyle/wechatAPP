<!-- pages/detail/detail.wxml -->
<view class="page-root">

  <!-- 加载骨架屏 -->
  <view class="skeleton-wrap" wx:if="{{loading}}">
    <view class="sk-hero shimmer"></view>
    <view class="sk-body">
      <view class="sk-line shimmer" style="width:60%;height:36rpx;"></view>
      <view class="sk-line shimmer" style="width:40%;height:28rpx;margin-top:16rpx;"></view>
      <view class="sk-line shimmer" style="width:80%;height:24rpx;margin-top:40rpx;"></view>
    </view>
  </view>

  <block wx:else>

    <!-- ① 沉浸式图片轮播（全屏，无导航栏遮挡） -->
    <view class="hero-swiper-wrap">
      <swiper
        class="hero-swiper"
        indicator-dots="{{product.images.length > 1}}"
        indicator-active-color="#C5A059"
        indicator-color="rgba(255,255,255,0.4)"
        autoplay circular
      >
        <swiper-item wx:for="{{product.images}}" wx:key="*this">
          <image
            src="{{item}}"
            class="hero-img"
            mode="aspectFill"
            bindtap="previewImage"
            data-url="{{item}}"
            lazy-load
          ></image>
        </swiper-item>
      </swiper>

      <!-- 浮在图片上的返回按钮 -->
      <view class="hero-back" bindtap="goBack">
        <view class="icon-back-circle">
          <view class="icon-arrow-left"></view>
        </view>
      </view>

      <!-- 图片右下角图片计数 -->
      <view class="hero-count" wx:if="{{product.images.length > 1}}">
        <view class="icon-img-sm"></view>
        <text>{{product.images.length}}</text>
      </view>
    </view>

    <!-- ② 商品信息卡 -->
    <view class="content-wrap">

      <!-- 名称与标签 -->
      <view class="name-row">
        <text class="product-name">{{product.name}}</text>
        <view class="tag-list">
          <view wx:if="{{product.is_hot}}" class="tag hot">热门</view>
          <view wx:if="{{product.is_new}}" class="tag new">新品</view>
          <view wx:if="{{product.brand_name}}" class="tag brand">{{product.brand_name}}</view>
        </view>
      </view>

      <!-- 价格卡 -->
      <view class="price-card">
        <view class="price-item main">
          <text class="p-label">日租</text>
          <view class="p-val-wrap">
            <text class="p-unit">¥</text>
            <text class="p-num">{{product.daily_rent}}</text>
            <text class="p-sub">/天</text>
          </view>
        </view>
        <view class="p-divider"></view>
        <view class="price-item">
          <text class="p-label">押金</text>
          <view class="p-val-wrap">
            <text class="p-unit small">¥</text>
            <text class="p-num small">{{product.deposit}}</text>
          </view>
          <text class="p-hint">还衣后退还</text>
        </view>
        <view class="p-divider"></view>
        <view class="price-item">
          <text class="p-label">已租</text>
          <view class="p-val-wrap">
            <text class="p-num small neutral">{{product.sales_count || 0}}</text>
            <text class="p-sub">次</text>
          </view>
        </view>
      </view>

      <!-- 规格选择 -->
      <view class="spec-section" wx:if="{{product.sizes && product.sizes.length}}">
        <view class="spec-label">尺码</view>
        <view class="spec-options">
          <view
            wx:for="{{product.sizes}}"
            wx:key="*this"
            class="spec-chip {{selectedSize === item ? 'active' : ''}}"
            bindtap="selectSize"
            data-size="{{item}}"
          >{{item}}</view>
        </view>
      </view>

      <view class="spec-section" wx:if="{{product.colors && product.colors.length}}">
        <view class="spec-label">颜色</view>
        <view class="spec-options color-opts">
          <view
            wx:for="{{product.colors}}"
            wx:key="*this"
            class="color-chip {{selectedColor === item ? 'active' : ''}}"
            bindtap="selectColor"
            data-color="{{item}}"
          >
            <view class="color-swatch" style="background:{{colorMap[item] || '#CCC'}};"></view>
            <text class="color-label">{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 商品描述 -->
      <view class="desc-section" wx:if="{{product.description}}">
        <view class="sec-title">宝贝详情</view>
        <text class="desc-text">{{product.description}}</text>
      </view>

      <!-- 详情图 -->
      <view class="detail-imgs" wx:if="{{product.images.length > 1}}">
        <image
          wx:for="{{product.images}}"
          wx:key="*this"
          src="{{item}}"
          mode="widthFix"
          class="detail-img"
          lazy-load
        ></image>
      </view>

      <!-- 底部安全区占位 -->
      <view style="height: 180rpx;"></view>
    </view>

  </block>

  <!-- ③ 底部磨砂玻璃操作栏 -->
  <view class="bottom-bar glass" wx:if="{{!loading}}">
    <view class="bottom-bar-inner">
      <view class="bar-action-btns">
        <view class="action-btn" bindtap="goToHome">
          <!-- 纯 CSS 房屋小图标 -->
          <view class="icon-home-sm"></view>
          <text class="action-label">首页</text>
        </view>
        <view class="action-btn" bindtap="contactService">
          <!-- 纯 CSS 客服气泡 -->
          <view class="icon-chat-sm"></view>
          <text class="action-label">客服</text>
        </view>
      </view>
      <view class="bar-cta">
        <view class="cta-btn" bindtap="showRentalModal">
          <text class="cta-text">立即预定</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ④ 租赁选择弹窗 -->
  <view class="mask {{showModal ? 'show' : ''}}" bindtap="hideRentalModal"></view>
  <view class="rental-sheet {{showModal ? 'show' : ''}}">
    <!-- 顶部把手 -->
    <view class="sheet-handle"></view>
    <view class="sheet-title">选择租赁方案</view>

    <!-- 方案卡片 -->
    <view class="rental-options">
      <view
        class="rental-card {{rentalType === 1 ? 'active' : ''}}"
        bindtap="selectRentalType"
        data-type="{{1}}"
      >
        <view class="rc-lead">
          <text class="rc-title">按日计租</text>
          <text class="rc-desc">自由选天数，灵活体验</text>
        </view>
        <view class="rc-price">
          <text class="rc-unit">¥</text>
          <text class="rc-num">{{product.daily_rent}}</text>
          <text class="rc-day">/天</text>
        </view>
        <view class="rc-check {{rentalType === 1 ? 'show' : ''}}"></view>
      </view>

      <view
        class="rental-card {{rentalType === 2 ? 'active' : ''}}"
        bindtap="selectRentalType"
        data-type="{{2}}"
      >
        <view class="rc-lead">
          <text class="rc-title">单次租赁</text>
          <text class="rc-desc">固定 3 天，性价比之选</text>
        </view>
        <view class="rc-price">
          <text class="rc-unit">¥</text>
          <text class="rc-num">{{product.single_rent}}</text>
          <text class="rc-day">/次</text>
        </view>
        <view class="rc-check {{rentalType === 2 ? 'show' : ''}}"></view>
      </view>
    </view>

    <!-- 天数选择（按日时显示） -->
    <view class="days-section" wx:if="{{rentalType === 1}}">
      <text class="days-label">租赁天数</text>
      <view class="days-options">
        <view
          wx:for="{{[1,2,3,5,7]}}"
          wx:key="*this"
          class="day-chip {{rentalDays === item ? 'active' : ''}}"
          bindtap="selectDays"
          data-days="{{item}}"
        >{{item}}天</view>
        <view class="day-chip {{rentalDays === 0 ? 'active' : ''}}" bindtap="selectDays" data-days="{{0}}">自定义</view>
      </view>
      <view class="day-custom-wrap" wx:if="{{rentalDays === 0}}">
        <input class="day-input" type="number" placeholder="输入天数" bindinput="onDaysInput" value="{{customDays}}" />
      </view>
    </view>

    <!-- 费用汇总 -->
    <view class="fee-summary">
      <view class="fee-row">
        <text class="fee-label">租金</text>
        <text class="fee-val">¥{{calculatedRent}}</text>
      </view>
      <view class="fee-row">
        <text class="fee-label">押金（退还）</text>
        <text class="fee-val muted">¥{{product.deposit}}</text>
      </view>
      <view class="fee-divider"></view>
      <view class="fee-row total">
        <text class="fee-label-total">预估总额</text>
        <view class="fee-total-wrap">
          <text class="fee-unit">¥</text>
          <text class="fee-total">{{calculatedTotal}}</text>
        </view>
      </view>
    </view>

    <!-- 确认按钮 -->
    <view class="sheet-btn" bindtap="submitOrder">确认预定</view>
    <view style="height: env(safe-area-inset-bottom);"></view>
  </view>

</view>
