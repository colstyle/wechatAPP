<!-- pages/detail/detail.wxml -->
<view class="page">
  <!-- 骨架屏/加载中 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-icon"></view>
    <text class="loading-text">正在加载美衣...</text>
  </view>

  <block wx:else>
    <!-- 商品图片轮播 -->
    <swiper class="image-swiper" indicator-dots="{{product.images.length > 1}}" autoplay circular indicator-active-color="#ff6b6b">
      <swiper-item wx:for="{{product.images}}" wx:key="*this">
        <image src="{{item}}" class="product-image" mode="aspectFill" bindtap="previewImage" data-url="{{item}}"></image>
      </swiper-item>
    </swiper>

    <!-- 商品基本信息 -->
    <view class="product-info card m-3">
      <view class="product-header">
        <text class="product-name">{{product.name}}</text>
      </view>
      
      <view class="product-tags">
        <text wx:if="{{product.is_hot}}" class="tag tag-hot">热门爆款</text>
        <text wx:if="{{product.is_new}}" class="tag tag-new">新品上架</text>
        <text class="tag tag-brand" wx:if="{{product.brand_name}}">{{product.brand_name}}</text>
      </view>

      <view class="product-price-box">
        <view class="price-row">
          <text class="price-label">日租</text>
          <text class="price">¥{{product.daily_rent}}</text>
        </view>
        <view class="price-row">
          <text class="price-label">单次(3天)</text>
          <text class="price">¥{{product.single_rent}}</text>
        </view>
        <view class="deposit-row">
          <text class="price-label">押金</text>
          <text class="price deposit">¥{{product.deposit}}</text>
          <text class="text-muted text-sm ml-2">(还衣后全额退还)</text>
        </view>
      </view>

      <view class="product-stats">
        <text>已租 {{product.sales_count || 0}} 次</text>
        <view class="stat-divider">|</view>
        <text>{{product.favorite_count || 0}} 人收藏</text>
        <view class="stat-divider">|</view>
        <text>库存 {{product.stock}} 件</text>
      </view>
    </view>

    <!-- 规格选择 -->
    <view class="section card m-3">
      <view class="section-title">选择规格</view>
      
      <view class="size-section mb-3">
        <text class="text-muted text-sm mb-2 block">尺码</text>
        <view class="size-options">
          <view 
            wx:for="{{product.sizes}}" 
            wx:key="*this" 
            class="size-option {{selectedSize === item ? 'active' : ''}}"
            bindtap="selectSize"
            data-size="{{item}}"
          >{{item}}</view>
        </view>
      </view>

      <view class="color-section">
        <text class="text-muted text-sm mb-2 block">颜色</text>
        <view class="color-options">
          <view 
            wx:for="{{product.colors}}" 
            wx:key="*this" 
            class="color-option {{selectedColor === item ? 'active' : ''}}"
            bindtap="selectColor"
            data-color="{{item}}"
          >
            <view class="color-dot" style="background-color: {{colorMap[item] || '#ccc'}}"></view>
            <text class="color-name">{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 商品详情 -->
    <view class="section card m-3">
      <view class="section-title">宝贝详情</view>
      <view class="product-desc">
        <text>{{product.description || '暂无详细描述'}}</text>
      </view>
      <!-- 这里可以添加更多详情图 -->
      <view class="detail-images mt-3">
        <image wx:for="{{product.images}}" wx:key="*this" src="{{item}}" mode="widthFix" class="w-100 mb-2" lazy-load></image>
      </view>
    </view>

  </block>

  <!-- 底部操作栏 -->
  <view class="footer" wx:if="{{!loading}}">
    <view class="footer-left">
      <view class="footer-btn" bindtap="goToHome">
        <text class="iconfont icon-home"></text>
        <text>首页</text>
      </view>
      <view class="footer-btn" bindtap="contactService">
        <text class="iconfont icon-service"></text>
        <text>客服</text>
      </view>
    </view>
    <view class="footer-right">
      <button class="footer-btn-main btn-primary" bindtap="showRentalModal">立即预定</button>
    </view>
  </view>

  <!-- 租赁弹窗 -->
  <view class="mask {{showModal ? 'show' : ''}}" bindtap="hideRentalModal"></view>
  <view class="rental-modal {{showModal ? 'show' : ''}}">
    <view class="modal-header">
      <text class="modal-title">选择租赁方案</text>
      <text class="modal-close" bindtap="hideRentalModal">×</text>
    </view>

    <view class="modal-body">
      <view class="rental-type {{rentalType === 1 ? 'active' : ''}}" bindtap="selectRentalType" data-type="{{1}}">
        <view class="rental-info">
          <text class="rental-title">按天租赁</text>
          <text class="text-muted text-sm block">自由选择天数，适合短期体验</text>
        </view>
        <text class="rental-desc">¥{{product.daily_rent}}/天</text>
      </view>

      <view class="rental-type {{rentalType === 2 ? 'active' : ''}}" bindtap="selectRentalType" data-type="{{2}}">
        <view class="rental-info">
          <text class="rental-title">单次租赁 (3天)</text>
          <text class="text-muted text-sm block">固定时长，更高性价比</text>
        </view>
        <text class="rental-desc">¥{{product.single_rent}}</text>
      </view>

      <view class="days-selector" wx:if="{{rentalType === 1}}">
        <text class="days-label">租赁天数</text>
        <view class="days-options">
          <view wx:for="{{[1,2,3,5,7]}}" wx:key="*this" class="day-option {{rentalDays === item ? 'active' : ''}}" bindtap="selectDays" data-days="{{item}}">{{item}}天</view>
          <view class="day-option {{rentalDays === 0 ? 'active' : ''}}" bindtap="selectDays" data-days="{{0}}">自定义</view>
        </view>
        <view class="days-custom" wx:if="{{rentalDays === 0}}">
          <input class="days-input" type="number" placeholder="请输入租赁天数" bindinput="onDaysInput" value="{{customDays}}" />
        </view>
      </view>

      <view class="price-calculation">
        <view class="calc-row">
          <text class="calc-label">租金：</text>
          <text class="calc-price">¥{{calculatedRent}}</text>
        </view>
        <view class="calc-row">
          <text class="calc-label">押金：</text>
          <text class="calc-price">¥{{product.deposit}}</text>
        </view>
        <view class="calc-row mt-2">
          <text class="calc-label">预估总额：</text>
          <text class="calc-total">¥{{calculatedTotal}}</text>
        </view>
      </view>
    </view>

    <view class="modal-footer">
      <button class="btn btn-primary btn-block btn-lg" bindtap="submitOrder">确定预定</button>
    </view>
  </view>
</view>
