/* pages/chat/chat.wxss */

.page-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FDFCF9;
}

.chat-list {
  flex: 1;
}

.chat-pad {
  padding: 32rpx 24rpx;
}

/* === 空状态 === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 160rpx;
}
.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(197,160,89,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}
/* 纯CSS大号气泡 */
.icon-chat-bubble {
  position: relative;
  width: 44rpx;
  height: 38rpx;
  border: 3.5rpx solid #C5A059;
  border-radius: 12rpx;
}
.icon-chat-bubble::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 8rpx;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-top: 10rpx solid #C5A059;
}
.empty-text {
  font-size: 32rpx;
  color: #1C1C1C;
  font-weight: 500;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 26rpx;
  color: #B0A99A;
}

/* === 消息项 === */
.message-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 40rpx;
  gap: 20rpx;
}
.message-item.user {
  flex-direction: row-reverse;
}

/* 头像 */
.avatar-wrap {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}
.avatar-ai, .avatar-user {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
}
.avatar-ai {
  background: rgba(197,160,89,0.15);
  color: #9A7B3A;
  border: 1.5rpx solid rgba(197,160,89,0.3);
}
.avatar-user {
  background: #1C1C1C;
  color: #FFFFFF;
}

/* 气泡 */
.bubble {
  max-width: 520rpx;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
/* AI 的气泡（白底） */
.bubble:not(.user) {
  background: #FFFFFF;
  color: #1C1C1C;
  border-radius: 24rpx 24rpx 24rpx 4rpx;
  box-shadow: 0 4rpx 20rpx rgba(28,28,28,0.03);
}
/* 用户的气泡（哑光金底） */
.bubble.user {
  background: #C5A059;
  color: #FFFFFF;
  border-radius: 24rpx 24rpx 4rpx 24rpx;
}

/* === 底部输入栏 === */
.footer-bar {
  padding: 20rpx 32rpx;
  background: rgba(253, 252, 249, 0.85);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(28,28,28,0.06);
}
.chat-input-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.chat-input {
  flex: 1;
  height: 84rpx;
  background: #FFFFFF;
  border-radius: 42rpx;
  padding: 0 36rpx;
  font-size: 28rpx;
  color: #1C1C1C;
  border: 1.5rpx solid rgba(28,28,28,0.06);
}
.chat-ph {
  color: #C0BBB4;
}

/* 发送按钮 */
.btn-send {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: rgba(28,28,28,0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s;
}
.btn-send.active {
  background: #1C1C1C;
}

/* 发送箭头 */
.icon-send-arrow {
  width: 20rpx;
  height: 20rpx;
  border-top: 3.5rpx solid #B0A99A;
  border-right: 3.5rpx solid #B0A99A;
  transform: rotate(45deg);
  margin-right: 4rpx;
}
.btn-send.active .icon-send-arrow {
  border-color: #FFFFFF;
}
