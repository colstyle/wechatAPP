<view class="container">
  <scroll-view class="chat-list" scroll-y scroll-into-view="{{lastMessageId}}">
    <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="message-item {{item.role}}">
      <view class="avatar">{{item.role === 'user' ? 'U' : 'AI'}}</view>
      <view class="content">
        <text>{{item.content}}</text>
      </view>
    </view>
    <view id="bottom-view"></view>
  </scroll-view>

  <view class="input-area">
    <input class="input" placeholder="请输入您的问题..." value="{{inputValue}}" bindinput="onInput" confirm-type="send" bindconfirm="onSend" />
    <button class="send-btn" type="primary" size="mini" bindtap="onSend" disabled="{{!inputValue || loading}}">发送</button>
  </view>
</view>
