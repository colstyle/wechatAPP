<!-- pages/chat/chat.wxml -->
<view class="page-root">
  
  <!-- 自定义导航栏 -->
  <cp-nav-bar title="AI 穿搭助理" show-back="{{true}}" bg="white"></cp-nav-bar>

  <scroll-view class="chat-list" scroll-y scroll-into-view="{{lastMessageId}}">
    <view class="chat-pad">
      
      <!-- 空状态欢迎语 -->
      <view class="empty-state" wx:if="{{messages.length === 0}}">
        <view class="empty-icon">
          <view class="icon-chat-bubble"></view>
        </view>
        <text class="empty-text">你好！我是你的专属 AI 穿搭顾问</text>
        <text class="empty-sub">你可以问我：「今天去参加婚礼怎么穿？」</text>
      </view>

      <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="message-item {{item.role}}">
        
        <!-- 头像区 -->
        <view class="avatar-wrap">
          <view class="avatar-ai" wx:if="{{item.role === 'ai' || item.role === 'assistant'}}">AI</view>
          <view class="avatar-user" wx:else>你</view>
        </view>
        
        <!-- 气泡区 -->
        <view class="bubble {{item.role}}">
          <text class="bubble-text">{{item.content}}</text>
        </view>
        
      </view>
      <view id="bottom-view" style="height: 60rpx;"></view>
    </view>
  </scroll-view>

  <!-- 底部输入栏 (磨砂玻璃) -->
  <view class="footer-bar glass">
    <!-- FAQ 快捷提问 -->
    <scroll-view class="faq-list" scroll-x wx:if="{{messages.length < 5}}">
      <view class="faq-item" wx:for="{{faqs}}" wx:key="id" bindtap="onFaqTap" data-id="{{item.id}}">
        {{item.question}}
      </view>
    </scroll-view>

    <view class="chat-input-wrap">
      <input 
        class="chat-input" 
        placeholder="聊聊你的穿搭需求..." 
        placeholder-class="chat-ph"
        value="{{inputValue}}" 
        bindinput="onInput" 
        confirm-type="send" 
        bindconfirm="onSend" 
      />
      <view class="btn-send {{inputValue ? 'active' : ''}}" bindtap="onSend">
        <!-- 纯CSS发送按钮箭头 -->
        <view class="icon-send-arrow"></view>
      </view>
    </view>
    <view style="height: env(safe-area-inset-bottom);"></view>
  </view>
  
</view>
