/* pages/settings/settings.wxss */
.page {
  background: #f8f9fa;
  min-height: 100vh;
}

/* 用户区域 */
.section {
  background: #fff;
  margin-bottom: 16rpx;
}

.user-section {
  padding: 32rpx 24rpx;
}

.user-header {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f8f9fa;
  margin-right: 24rpx;
}

.user-info {
  flex: 1;
}

.user-nickname {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #212529;
  margin-bottom: 8rpx;
}

.user-phone {
  display: block;
  font-size: 26rpx;
  color: #adb5bd;
}

/* 功能区域 */
.function-section {
  padding: 0 24rpx;
}

.function-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #dee2e6;
}

.function-item:last-child {
  border-bottom: none;
}

.function-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.function-text {
  flex: 1;
  font-size: 28rpx;
  color: #495057;
}

.function-item .icon-arrow-right {
  color: #adb5bd;
  font-size: 24rpx;
}

.section-title {
  padding: 24rpx 0 8rpx;
  font-size: 26rpx;
  color: #868e96;
}

.api-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #dee2e6;
}

.api-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #495057;
}

.api-input {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #212529;
}

.api-actions {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 0 32rpx;
}

.api-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.api-btn-secondary {
  background: #f1f3f5;
  color: #495057;
}

.api-btn-primary {
  background: #4c6ef5;
  color: #fff;
}

/* 版本信息 */
.version-section {
  text-align: center;
  padding: 48rpx;
}

.version-text {
  font-size: 24rpx;
  color: #adb5bd;
}
