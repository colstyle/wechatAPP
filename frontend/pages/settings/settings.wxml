<!-- pages/settings/settings.wxml -->
<view class="page-root">
  <cp-nav-bar title="设置与偏好" show-back="{{true}}" bg="white"></cp-nav-bar>

  <scroll-view class="content" scroll-y>
    
    <!-- 个人信息卡片 -->
    <view class="card profile-card" bindtap="onProfileTap">
      <view class="pc-left">
        <view class="avatar-wrap">
          <image class="avatar-img" src="{{userInfo.avatar || ''}}" mode="aspectFill" wx:if="{{userInfo.avatar}}"></image>
          <view class="avatar-placeholder" wx:else>
            <view class="icon-person-sm"></view>
          </view>
        </view>
        <view class="pc-info">
          <text class="pc-name">{{userInfo.nickname || '未登录配置'}}</text>
          <text class="pc-sub">{{userInfo.phone || '点击完善个人信息'}}</text>
        </view>
      </view>
      <view class="arrow-right"></view>
    </view>

    <!-- 常规设置卡片 -->
    <view class="card menu-card">
      <view class="menu-item" bindtap="onSizeTap">
        <view class="mi-icon-wrap mi-gold">
          <view class="icon-ruler"></view>
        </view>
        <text class="mi-text">我的尺码档案</text>
        <view class="arrow-right"></view>
      </view>
      <view class="menu-item last" bindtap="onAboutTap">
        <view class="mi-icon-wrap mi-sage">
          <view class="icon-info"></view>
        </view>
        <text class="mi-text">关于小时光租衣舍</text>
        <view class="arrow-right"></view>
      </view>
    </view>

    <!-- 开发设置卡片 (用于测试) -->
    <view class="card dev-card">
      <view class="dev-title">开发设置 (Developer)</view>
      
      <view class="dev-field">
        <text class="dev-label">后端 API 聚点</text>
        <input 
          class="dev-input" 
          value="{{apiBase}}"
          placeholder="例如：https://www.celestialaiplus.com"
          bindinput="onApiBaseInput"
          confirm-type="done"
        />
        <view class="dev-btn-group">
          <view class="dev-btn sub" bindtap="testApiBase">连通测试</view>
          <view class="dev-btn main" bindtap="saveApiBase">应用地址</view>
        </view>
      </view>

      <view class="dev-divider"></view>

      <view class="dev-field">
        <text class="dev-label">身份模拟标识 (OpenID)</text>
        <input 
          class="dev-input" 
          value="{{mockOpenid}}"
          placeholder="普通：user_1  店长：admin_1"
          bindinput="onMockOpenidInput"
          confirm-type="done"
        />
        <view class="dev-btn-group">
          <view class="dev-btn sub" bindtap="useMockUser">切为用户</view>
          <view class="dev-btn sub" bindtap="useMockAdmin">切为店主</view>
          <view class="dev-btn main" bindtap="reLogin">强制重载</view>
        </view>
      </view>
    </view>

    <!-- 版本标记 -->
    <view class="version-mark">
      <text class="vm-text">小时光 V 1.0.0(Alpha)</text>
    </view>

    <view style="height: 120rpx;"></view>
  </scroll-view>
</view>
