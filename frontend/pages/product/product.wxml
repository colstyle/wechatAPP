<!--pages/product/product.wxml-->
<view class="page">
  <!-- 搜索框 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索商品" bindconfirm="onSearchConfirm" confirm-type="search" value="{{keyword}}"/>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-item" bindtap="onSortTap">
      <text>排序</text>
      <text class="iconfont icon-arrow-down"></text>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="product-list">
    <view
      class="product-card"
      wx:for="{{products}}"
      wx:key="id"
      bindtap="onProductTap"
      data-id="{{item.id}}">
      <image class="product-img" src="{{item.cover_image}}" mode="aspectFill"></image>
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <view class="product-bottom">
          <view class="product-price-row">
            <text class="product-price">¥{{item.daily_rent}}</text>
            <text class="product-unit">/天</text>
          </view>
          <view class="product-stock">库存: {{item.stock}}</view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty" wx:if="{{products.length === 0 && !loading}}">
      <text>暂无商品</text>
    </view>

    <!-- 加载中 -->
    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}">
    <text wx:if="{{loading}}">加载中...</text>
    <text wx:else bindtap="onLoadMore">加载更多</text>
  </view>

  <!-- 到底 -->
  <view class="no-more" wx:if="{{!hasMore && products.length > 0}}">
    <text>已经到底了</text>
  </view>
</view>
