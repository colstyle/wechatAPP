/* pages/channel/sale999/sale999.wxss */
/* 通用频道页样式 — 所有 channel 子页复用此结构 */

.page-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FDFCF9;
  overflow: hidden;
}

/* ===== 频道 Banner ===== */
.channel-banner {
  margin: 0 24rpx 0;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.10);
}
.banner-emoji {
  font-size: 72rpx;
  line-height: 1;
  flex-shrink: 0;
}
.banner-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.banner-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}
.banner-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.6;
}

/* ===== 滚动区 ===== */
.scroll-body {
  flex: 1;
  overflow: hidden;
}

/* ===== 商品网格 ===== */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 24rpx 20rpx;
}

/* ===== 骨架屏 ===== */
.shimmer-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(28,28,28,0.04);
}
.shimmer-img {
  width: 100%;
  height: 280rpx;
}
.shimmer-line {
  border-radius: 8rpx;
}
.shimmer {
  background: linear-gradient(90deg, #f0ede8 25%, #e8e4de 50%, #f0ede8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ===== 空状态 ===== */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 130rpx;
  gap: 16rpx;
}
.empty-emoji {
  font-size: 88rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #B0A99A;
}

/* ===== 底部状态栏 ===== */
.load-footer {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 40rpx;
}
.loading-dots { display: flex; gap: 8rpx; }
.dot {
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  background: #C5A059;
  animation: dotBounce 1.2s infinite ease-in-out both;
}
.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }
@keyframes dotBounce {
  0%,80%,100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}
.no-more {
  font-size: 24rpx;
  color: #C0BBB4;
}
