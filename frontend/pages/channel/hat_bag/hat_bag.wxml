<!-- pages/channel/hat_bag/hat_bag.wxml -->
<view class="page-root">
  <cp-nav-bar title="{{title}}" show-back="{{true}}" bg="white"></cp-nav-bar>
  <view class="channel-banner" style="background: linear-gradient(135deg, {{accentColor}}CC, {{accentColor}}88);">
    <text class="banner-emoji">{{emoji}}</text>
    <view class="banner-info">
      <text class="banner-title">{{title}}</text>
      <text class="banner-desc">{{desc}}</text>
    </view>
  </view>
  <scroll-view class="scroll-body" scroll-y enable-back-to-top>
    <view class="product-grid" wx:if="{{loading && products.length === 0}}">
      <view class="shimmer-card" wx:for="{{[0,1,2,3]}}" wx:key="*this">
        <view class="shimmer-img shimmer"></view>
        <view class="shimmer-line shimmer" style="width:70%;height:24rpx;margin:16rpx 16rpx 8rpx;"></view>
        <view class="shimmer-line shimmer" style="width:40%;height:20rpx;margin:0 16rpx 20rpx;"></view>
      </view>
    </view>
    <view class="product-grid" wx:elif="{{products.length > 0}}">
      <cp-product-card wx:for="{{products}}" wx:key="id" product="{{item}}" bindtap="onProductTap" data-id="{{item.id}}"></cp-product-card>
    </view>
    <view class="empty-box" wx:elif="{{!loading}}">
      <text class="empty-emoji">📦</text>
      <text class="empty-text">该频道暂无商品，敬请期待</text>
    </view>
    <view class="load-footer" wx:if="{{products.length > 0}}">
      <view class="loading-dots" wx:if="{{loading}}"><view class="dot"></view><view class="dot"></view><view class="dot"></view></view>
      <text class="no-more" wx:elif="{{!hasMore}}">— 已展示全部 —</text>
    </view>
    <view style="height: env(safe-area-inset-bottom);"></view>
  </scroll-view>
</view>
