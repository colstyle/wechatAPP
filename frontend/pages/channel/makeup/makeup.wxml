<!-- pages/channel/makeup/makeup.wxml -->
<view class="page-root">
  <cp-nav-bar title="{{title}}" show-back="{{true}}" bg="white"></cp-nav-bar>

  <view class="channel-banner" style="background: linear-gradient(135deg, {{accentColor}}CC, {{accentColor}}88);">
    <text class="banner-emoji">{{emoji}}</text>
    <view class="banner-info">
      <text class="banner-title">{{title}}</text>
      <text class="banner-desc">专业化妆师陪你美出自我</text>
    </view>
  </view>

  <scroll-view class="scroll-body" scroll-y>
    <view class="sections-wrap">
      <view class="info-section" wx:for="{{sections}}" wx:key="id">
        <view class="section-title">{{item.title}}</view>
        <view class="section-card">
          <view class="section-item" wx:for="{{item.items}}" wx:key="*this" wx:for-item="note">
            <view class="bullet-dot"></view>
            <text class="item-text">{{note}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="contact-wrap">
      <view class="contact-btn" bindtap="onContactTap">
        <text class="contact-icon">💬</text>
        <text class="contact-text">立即预约化妆造型</text>
      </view>
    </view>
    <view style="height: calc(40rpx + env(safe-area-inset-bottom));"></view>
  </scroll-view>
</view>
