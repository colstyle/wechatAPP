<!--pages/orders/orders.wxml-->
<view class="page">
  <!-- 订单列表 -->
  <view class="order-list">
    <view
      class="order-card"
      wx:for="{{orders}}"
      wx:key="id"
      bindtap="onOrderTap"
      data-id="{{item.id}}">
      <view class="order-header">
        <text class="order-no">订单号: {{item.order_no}}</text>
        <text class="order-status status-{{item.status}}">{{item.statusText}}</text>
      </view>

      <view class="order-items">
        <view class="order-item-mini" wx:for="{{item.items}}" wx:for-item="subItem" wx:key="id">
          <image class="item-img" src="{{subItem.product_image}}" mode="aspectFill"></image>
          <view class="item-info">
            <text class="item-name">{{subItem.product_name}}</text>
            <text class="item-spec">{{subItem.size}} / {{subItem.color}}</text>
          </view>
          <view class="item-price">
            <text class="price">¥{{subItem.rent_price}}</text>
          </view>
        </view>
      </view>

      <view class="order-footer">
        <text class="order-time">{{item.created_at}}</text>
        <view class="order-actions">
          <button
            class="btn btn-sm btn-primary"
            wx:if="{{item.status === 0}}"
            bindtap="onPayTap"
            data-id="{{item.id}}"
            catchtap="true">
            去支付
          </button>
          <button
            class="btn btn-sm btn-outline"
            wx:if="{{item.status === 2}}"
            bindtap="onReceiveTap"
            data-id="{{item.id}}"
            catchtap="true">
            确认收货
          </button>
          <button
            class="btn btn-sm btn-outline"
            wx:if="{{item.status === 2 || item.status === 3}}"
            bindtap="onReturnTap"
            data-id="{{item.id}}"
            catchtap="true">
            申请归还
          </button>
          <button
            class="btn btn-sm btn-danger"
            wx:if="{{item.status === 0}}"
            bindtap="onCancelTap"
            data-id="{{item.id}}"
            catchtap="true">
            取消订单
          </button>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty" wx:if="{{orders.length === 0 && !loading}}">
      <text>暂无订单</text>
    </view>

    <!-- 加载中 -->
    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}">
    <text wx:if="{{loading}}">加载中...</text>
    <text wx:else bindtap="onLoadMore">加载更多</text>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-placeholder"></view>
</view>
