/* pages/orders/orders.wxss */
.page {
  background: #f7f7f7;
  min-height: 100vh;
}

/* 订单列表 */
.order-list {
  padding: 20rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.10);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.order-no {
  font-size: 24rpx;
  color: #6c757d;
}

.order-status {
  font-size: 24rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
}

.order-status.status-0 {
  background: #e9ecef;
  color: #495057;
}

.order-status.status-1 {
  background: rgba(47, 128, 237, 0.12);
  color: #2f80ed;
}

.order-status.status-2 {
  background: rgba(46, 204, 113, 0.12);
  color: #2ecc71;
}

.order-status.status-3 {
  background: rgba(235, 87, 87, 0.14);
  color: #eb5757;
}

.order-status.status-4 {
  background: rgba(47, 128, 237, 0.12);
  color: #2f80ed;
}

.order-status.status-5 {
  background: rgba(235, 87, 87, 0.14);
  color: #eb5757;
}

.order-status.status-6 {
  background: rgba(46, 204, 113, 0.12);
  color: #2ecc71;
}

/* 订单商品 */
.order-items {
  padding: 16rpx 24rpx;
}

.order-item-mini {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-item-mini:last-child {
  margin-bottom: 0;
}

.item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.item-info {
  flex: 1;
}

.item-name {
  display: block;
  font-size: 28rpx;
  color: #212529;
  margin-bottom: 8rpx;
}

.item-spec {
  font-size: 24rpx;
  color: #adb5bd;
}

.item-price {
  text-align: right;
}

.item-price .price {
  font-size: 28rpx;
  color: #ff6348;
  font-weight: 500;
}

/* 订单底部 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx 24rpx;
  background: #f7f7f7;
}

.order-time {
  font-size: 24rpx;
  color: #adb5bd;
}

.order-actions {
  display: flex;
  gap: 12rpx;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #adb5bd;
  font-size: 28rpx;
}

/* 加载中 */
.loading {
  padding: 48rpx;
  text-align: center;
  color: #adb5bd;
  font-size: 28rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 32rpx;
  color: #adb5bd;
  font-size: 28rpx;
}

/* 底部占位 */
.bottom-placeholder {
  height: 120rpx;
}
