/* pages/orders/orders.wxss */

.page-root {
  min-height: 100vh;
  background: #FDFCF9;
  display: flex;
  flex-direction: column;
}

.order-scroll {
  flex: 1;
}

.order-list {
  padding: 24rpx 32rpx;
}

/* === 订单卡片 === */
.order-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(28, 28, 28, 0.03);
}

.oc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(28,28,28,0.04);
}

.oc-no-wrap {
  display: flex;
  align-items: baseline;
}
.oc-hash {
  font-size: 24rpx;
  color: #B0A99A;
  margin-right: 4rpx;
}
.oc-no {
  font-size: 26rpx;
  color: #1C1C1C;
  font-weight: 500;
}

/* 状态色系：莫兰迪色偏好 */
.oc-status {
  font-size: 24rpx;
  font-weight: 600;
}
.oc-status.status-0 { color: #C5A059; } /* 待支付 */
.oc-status.status-1, .oc-status.status-2 { color: #8E9775; } /* 待收货/租赁中 */
.oc-status.status-3 { color: #B05B5B; } /* 已逾期 */
.oc-status.status-7 { color: #B0A99A; } /* 已完成 */

/* 商品列表区 */
.oc-body {
  padding: 24rpx 32rpx;
}

.mini-product-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.mini-product-item:last-child { margin-bottom: 0; }

.mp-img {
  width: 100rpx; height: 100rpx;
  border-radius: 12rpx;
  background: #F5F4F0;
  margin-right: 20rpx;
}

.mp-info { flex: 1; min-width: 0; }
.mp-name {
  display: block;
  font-size: 26rpx;
  color: #1C1C1C;
  font-weight: 500;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.mp-spec {
  font-size: 22rpx;
  color: #B0A99A;
}

.mp-price { text-align: right; }
.p-sym { font-size: 20rpx; color: #1C1C1C; font-weight: 600; }
.p-val { font-size: 28rpx; color: #1C1C1C; font-weight: bold; }

/* 底部操作区 */
.oc-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx 28rpx;
  background: rgba(253, 252, 249, 0.4);
}

.oc-time-wrap {
  display: flex;
  align-items: center;
}
.oc-time {
  font-size: 22rpx;
  color: #B0A99A;
}

.oc-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  margin: 0;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 52rpx;
  font-size: 24rpx;
  border-radius: 28rpx;
  font-weight: 500;
  transition: all 0.2s;
  box-sizing: border-box;
}

.btn-gold {
  background: #1C1C1C;
  color: #FFFFFF;
  border: 1rpx solid #1C1C1C;
}

.btn-outline {
  background: #FFFFFF;
  color: #6B6660;
  border: 1rpx solid #D4CFC9;
}

.btn-minor {
  background: transparent;
  color: #B0A99A;
  border: 1rpx solid transparent;
}

/* 底部提示 */
.no-more {
  text-align: center;
  font-size: 22rpx;
  color: #B0A99A;
  padding: 40rpx 0 60rpx;
  letter-spacing: 1px;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.loading-dots { display: flex; gap: 8rpx; }
.dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #C5A059; animation: dotBounce 1.2s infinite ease-in-out both; }
.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }
@keyframes dotBounce { 0%,80%,100% { transform: scale(0.6); opacity: 0.4; } 40% { transform: scale(1); opacity: 1; } }
