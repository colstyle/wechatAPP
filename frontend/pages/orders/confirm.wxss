/* pages/orders/confirm.wxss */

.page-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FDFCF9;
  overflow: hidden;
}

.content-scroll {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

/* === 卡片基础 === */
.section-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(28,28,28,0.03);
}
.sec-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1C;
  margin-bottom: 24rpx;
}

/* 商品项 */
.product-item {
  display: flex; gap: 24rpx; padding: 20rpx 0; border-bottom: 1rpx dashed rgba(28,28,28,0.06);
}
.product-item:last-child { border-bottom: none; padding-bottom: 0; }
.product-item:first-child { padding-top: 0; }
.p-img { width: 140rpx; height: 180rpx; border-radius: 12rpx; background: #F5F4F0; }
.p-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.p-name { font-size: 28rpx; color: #1C1C1C; font-weight: 500; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.p-spec { display: flex; align-items: center; gap: 12rpx; margin-top: auto; }
.tag { font-size: 20rpx; color: #8E877F; background: #FDFCF9; padding: 4rpx 12rpx; border-radius: 6rpx; border: 1rpx solid rgba(28,28,28,0.05); }
.qty { margin-left: auto; font-size: 24rpx; color: #B0A99A; }

/* 行列表 */
.row-list { display: flex; flex-direction: column; gap: 24rpx; }
.row-item { display: flex; align-items: center; justify-content: space-between; }
.row-label { font-size: 26rpx; color: #8E877F; }
.row-val { font-size: 28rpx; color: #1C1C1C; font-weight: 500; }
.mode-text { color: #C5A059; background: rgba(197,160,89,0.1); padding: 4rpx 16rpx; border-radius: 999rpx; font-size: 24rpx;}
.date-picker { display: flex; align-items: center; gap: 8rpx; }
.icon-arrow { width: 12rpx; height: 12rpx; border-right: 2rpx solid #C0BBB4; border-bottom: 2rpx solid #C0BBB4; transform: rotate(-45deg); }

/* 价格 */
.price { color: #1C1C1C; font-family: 'Helvetica Neue', sans-serif; font-size: 32rpx; }
.sub-label { font-size: 22rpx; color: #B0A99A; }
.sub { color: #8E877F; font-size: 28rpx; font-weight: 400; }

/* 备注 */
.remark-box { background: rgba(238, 236, 232, 0.4); border-radius: 12rpx; padding: 20rpx; }
.remark-input { width: 100%; min-height: 80rpx; font-size: 26rpx; color: #1C1C1C; }
.ph-style { color: #C0BBB4; }

/* === 悬浮脚部 === */
.footer-glass {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(253, 252, 249, 0.95);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(28,28,28,0.06);
  z-index: 100;
}
.f-left { display: flex; align-items: baseline; gap: 8rpx; }
.f-lbl { font-size: 24rpx; color: #8E877F; }
.f-sym { font-size: 26rpx; color: #B05B5B; font-weight: 600; margin-left: 8rpx; }
.f-total { font-size: 44rpx; color: #B05B5B; font-weight: 600; font-family: 'Helvetica Neue', sans-serif;}

.btn-submit {
  height: 88rpx;
  padding: 0 48rpx;
  background: #1C1C1C;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(28,28,28,0.15);
}
.icon-submit-arrow {
  width: 14rpx; height: 14rpx;
  border-top: 2.5rpx solid #FFFFFF;
  border-right: 2.5rpx solid #FFFFFF;
  transform: rotate(45deg);
  margin-right: 2rpx;
}
