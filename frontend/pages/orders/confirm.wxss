/* pages/orders/confirm.wxss */
.page {
  background: #f8f9fa;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 区域 */
.section {
  background: #fff;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
  color: #212529;
}

.change-btn {
  font-size: 26rpx;
  color: #ff6b6b;
}

/* 商品信息 */
.product-info-card {
  display: flex;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.product-img {
  width: 180rpx;
  height: 240rpx;
  border-radius: 8rpx;
  margin-right: 24rpx;
}

.product-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #212529;
  margin-bottom: 12rpx;
}

.product-spec {
  font-size: 24rpx;
  color: #6c757d;
}

/* 租赁信息 */
.rental-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
}

.info-row .label {
  font-size: 28rpx;
  color: #6c757d;
}

.info-row .value {
  font-size: 28rpx;
  color: #212529;
  font-weight: 500;
}

.info-row .value.price {
  color: #ff6348;
}

/* 地址卡片 */
.address-card {
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 24rpx;
}

.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.address-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #212529;
  margin-right: 16rpx;
}

.address-phone {
  font-size: 28rpx;
  color: #6c757d;
  margin-right: auto;
}

.default-badge {
  background: #ff6b6b;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.address-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.address-region {
  font-size: 26rpx;
  color: #495057;
}

.address-detail {
  font-size: 26rpx;
  color: #6c757d;
  line-height: 1.5;
}

.no-address {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 48rpx 24rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  color: #adb5bd;
  font-size: 28rpx;
}

.no-address .icon-arrow-right {
  color: #adb5bd;
  font-size: 24rpx;
}

/* 备注输入 */
.remark-input {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
}

/* 底部占位 */
.bottom-placeholder {
  height: 120rpx;
}

/* 底部提交栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.1);
}

.footer-left {
  display: flex;
  flex-direction: column;
}

.total-label {
  font-size: 24rpx;
  color: #6c757d;
}

.total-price {
  font-size: 40rpx;
  color: #ff6348;
  font-weight: bold;
}

/* 按钮样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 48rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  background: none;
}

.btn-primary {
  background: #ff6b6b;
  color: #fff;
}

.footer-btn {
  padding: 20rpx 48rpx;
}
