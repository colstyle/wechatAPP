<!--pages/orders/confirm.wxml-->
<view class="page">
  <!-- 商品信息 -->
  <view class="section">
    <view class="section-title">商品信息</view>
    <view class="product-info-card" wx:for="{{displayItems}}" wx:key="index">
      <image class="product-img" src="{{item.product.cover_image}}" mode="aspectFill"></image>
      <view class="product-detail">
        <text class="product-name">{{item.product.name}}</text>
        <text class="product-spec">尺码: {{item.size}} | 颜色: {{item.color}} ×{{item.quantity}}</text>
      </view>
    </view>
  </view>

  <!-- 租赁信息 -->
  <view class="section">
    <view class="section-title">租赁信息</view>
    <view class="rental-info">
      <view class="info-row">
        <text class="label">租赁类型:</text>
        <text class="value">{{rentalTypeText}}</text>
      </view>
      <view class="info-row" wx:if="{{rentalType === 1 || rentalType === 2}}">
        <text class="label">使用日期:</text>
        <picker mode="date" start="{{todayDate}}" value="{{startDate}}" bindchange="onDateChange">
          <view class="value">{{startDate || '请选择日期'}}</view>
        </picker>
      </view>
      <view class="info-row" wx:if="{{rentalType === 1}}">
        <text class="label">租赁天数:</text>
        <text class="value">{{rentDays}}天</text>
      </view>
      <view class="info-row">
        <text class="label">租金:</text>
        <text class="value price">¥{{calculatedRent}}</text>
      </view>
      <view class="info-row">
        <text class="label">押金:</text>
        <text class="value price">¥{{calculatedDeposit}}</text>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="section">
    <view class="section-title">备注</view>
    <textarea
      class="remark-input"
      placeholder="选填，请输入备注信息"
      value="{{remark}}"
      bindinput="onRemarkInput"
      maxlength="200"
    ></textarea>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-placeholder"></view>

  <!-- 底部提交栏 -->
  <view class="footer">
    <view class="footer-left">
      <text class="total-label">应付金额</text>
      <text class="total-price">¥{{calculatedTotal}}</text>
    </view>
    <button class="btn btn-primary footer-btn" bindtap="onSubmit">
      提交订单
    </button>
  </view>
</view>
