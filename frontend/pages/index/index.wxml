<!--pages/index/index.wxml-->
<view class="page">
  <!-- 日期选择器 (核心需求：优先选择日期) -->
  <view class="date-picker-section">
    <picker mode="date" value="{{selectedDate}}" start="{{startDate}}" end="{{endDate}}" bindchange="onDateChange">
      <view class="date-picker-trigger">
        <text class="date-picker-icon">📅</text>
        <text class="date-picker-text">{{selectedDate ? '当前预约日期：' + selectedDate : '请先选择租赁日期'}}</text>
        <text class="date-picker-arrow">修改 ></text>
      </view>
    </picker>
  </view>

  <!-- 分类导航 -->
  <view class="category-nav">
    <view class="category-item" wx:for="{{categories}}" wx:key="id" bindtap="onCategoryTap" data-id="{{item.id}}">
      <view class="category-icon-wrap" style="background: {{item.gradient}}">
        <text class="category-emoji">{{item.emoji}}</text>
      </view>
      <text class="category-name">{{item.name}}</text>
    </view>
  </view>

  <!-- 可租衣物列表 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">可租衣物</text>
    </view>
    <view class="product-grid">
      <view class="product-card" wx:for="{{products}}" wx:key="id" bindtap="onProductTap" data-id="{{item.id}}">
        <image class="product-cover" src="{{item.cover_image}}" mode="aspectFill"></image>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <view class="product-bottom">
            <view class="product-price-row">
              <text class="product-price">¥{{item.daily_rent}}</text>
              <text class="product-unit">/天</text>
            </view>
            <text class="product-single">押金 ¥{{item.deposit}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="load-more" wx:if="{{hasMore}}">
      <text wx:if="{{loading}}">加载中...</text>
      <text wx:else bindtap="onLoadMore">加载更多</text>
    </view>
    <view class="no-more" wx:if="{{!hasMore && products.length > 0}}">
      <text>已经到底了</text>
    </view>
    <view class="empty" wx:if="{{!loading && products.length === 0}}">
      <text>该日期暂无可租衣物</text>
    </view>
  </view>

  <!-- AI 客服悬浮按钮 -->
  <navigator url="/pages/chat/chat" class="ai-fab">
    <text class="ai-fab-icon">🤖</text>
    <text class="ai-fab-text">客服</text>
  </navigator>
</view>
