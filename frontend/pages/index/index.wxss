/* pages/index/index.wxss */

/* === 页面根 === */
.page-root {
  min-height: 100vh;
  background: #FDFCF9;
  padding-bottom: 120rpx;
  position: relative;
}

/* === 头部大屏 (Hero) === */
.hero-section {
  position: relative;
  width: 100%;
  height: 600rpx;
  background: #1C1C1C;
  z-index: 1;
}

.hero-nav-holder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
}

.hero-img {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

.hero-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 200rpx;
  background: linear-gradient(to top, rgba(253, 252, 249, 1), rgba(253, 252, 249, 0));
}

/* === 主体内容 === */
.main-body {
  position: relative;
  z-index: 10;
  padding: 0 24rpx;
  margin-top: -80rpx; /* 悬浮重叠效果 */
}

/* 阴影公共类 */
.shadow-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(28, 28, 28, 0.05);
  margin-bottom: 24rpx;
}

/* === 核心功能悬浮卡 (Function Area) === */
.function-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 20rpx;
}

.func-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(197, 160, 89, 0.15);
}

.func-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  position: relative;
}

/* 手绘/艺术感 CSS Icon */
.icon-dress-art {
  width: 36rpx; height: 44rpx; border: 4rpx solid #1C1C1C; border-radius: 6rpx 6rpx 16rpx 16rpx; position: relative; border-top: none;
}
.icon-dress-art::before {
  content: ''; position: absolute; top: -8rpx; left: -10rpx; right: -10rpx; height: 8rpx; border: 4rpx solid #1C1C1C; border-radius: 8rpx;
}

.icon-pkg-art {
  width: 40rpx; height: 40rpx; border: 4rpx solid #C5A059; border-radius: 8rpx; position: relative;
}
.icon-pkg-art::after {
  content: ''; position: absolute; left: 50%; top: -6rpx; bottom: 8rpx; width: 4rpx; background: #C5A059; transform: translateX(-50%);
}

.icon-store-art {
  width: 44rpx; height: 36rpx; border: 4rpx solid #8E9775; border-radius: 8rpx; position: relative; border-bottom: none;
}
.icon-store-art::after {
  content: ''; position: absolute; bottom: -8rpx; left: -10rpx; right: -10rpx; height: 8rpx; background: #8E9775; border-radius: 8rpx;
}

.func-text {
  text-align: center;
  display: flex;
  flex-direction: column;
}

.func-title {
  font-size: 26rpx;
  color: #1C1C1C;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.func-sub {
  font-size: 18rpx;
  color: #8E877F;
  letter-spacing: 0.5px;
}

/* === 精致日期选择器 (Sleek Date Bar) === */
.sleek-date-bar {
  padding: 0;
  overflow: hidden;
}

.date-picker-wrap {
  width: 100%;
}

.date-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  background: linear-gradient(90deg, #FDFCF9, #FFFFFF);
}

.date-left {
  display: flex;
  align-items: center;
}

.icon-date-art {
  width: 24rpx; height: 24rpx; border: 3rpx solid #C5A059; border-radius: 6rpx; position: relative; margin-right: 12rpx;
}
.icon-date-art::before {
  content: ''; position: absolute; top: -6rpx; left: 4rpx; width: 4rpx; height: 8rpx; background: #C5A059;
}
.icon-date-art::after {
  content: ''; position: absolute; top: -6rpx; right: 4rpx; width: 4rpx; height: 8rpx; background: #C5A059;
}

.date-label {
  font-size: 24rpx;
  color: #1C1C1C;
  font-weight: 600;
}

.date-right {
  display: flex;
  align-items: center;
}

.date-value {
  font-size: 26rpx;
  color: #B0A99A;
  margin-right: 12rpx;
}

.date-value.has-val {
  color: #1C1C1C;
  font-weight: 500;
  letter-spacing: 1px;
}

.arrow-right {
  width: 12rpx; height: 12rpx; border-top: 3rpx solid #C0BBB4; border-right: 3rpx solid #C0BBB4; transform: rotate(45deg);
}

/* === 品牌文化横幅 === */
.banner-section {
  width: 100%;
  height: 240rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(197, 160, 89, 0.1);
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-text-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(90deg, rgba(28,28,28,0.7) 0%, rgba(28,28,28,0.1) 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-left: 40rpx;
}

.bt-title {
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.5);
}

.bt-sub {
  color: #FDFCF9;
  font-size: 20rpx;
  opacity: 0.9;
  letter-spacing: 1rpx;
}

/* === 商品区 === */
.products-section {
  padding: 0 8rpx;
}
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1C;
  letter-spacing: 0.5px;
}
.section-hint {
  font-size: 22rpx;
  color: #C5A059;
}

/* 商品网格 */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

/* 骨架屏占位卡 */
.shimmer-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}
.shimmer-img {
  width: 100%;
  padding-bottom: 133.33%;
}

@keyframes shimmer {
  0%   { background-position: -600rpx 0; }
  100% { background-position: 600rpx 0; }
}
.shimmer {
  background: linear-gradient(90deg, #EEECE8 25%, #E2DED8 50%, #EEECE8 75%);
  background-size: 1200rpx 100%;
  animation: shimmer 1.4s ease-in-out infinite;
}

/* 空状态 */
.empty-box {
  text-align: center;
  padding: 80rpx 0 60rpx;
}

/* 加载更多 */
.load-footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
}
.load-more-btn {
  font-size: 24rpx;
  color: #C5A059;
  padding: 16rpx 48rpx;
  border: 1rpx solid #C5A059;
  border-radius: 999rpx;
}
.no-more {
  font-size: 20rpx;
  color: #B0A99A;
  letter-spacing: 2px;
}

/* 加载动效 - 三点 */
.loading-dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #C5A059;
  animation: dotBounce 1.2s ease-in-out infinite both;
}
.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }
@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40%            { transform: scale(1);   opacity: 1; }
}

/* === AI 客服悬浮球 === */
.ai-fab {
  position: fixed;
  right: 32rpx;
  bottom: 180rpx;
  z-index: 500;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.fab-inner {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #1C1C1C;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(28, 28, 28, 0.25);
}
.fab-chat-bubble {
  width: 40rpx;
  height: 36rpx;
  border: 3rpx solid #FFFFFF;
  border-radius: 10rpx;
  position: relative;
}
.fab-chat-tail {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 0 solid transparent;
  border-top: 10rpx solid #FFFFFF;
  position: absolute;
  bottom: -13rpx;
  left: 10rpx;
}
.fab-hint {
  font-size: 18rpx;
  color: #6B6660;
  margin-top: 6rpx;
  letter-spacing: 1px;
}
