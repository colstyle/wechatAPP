/* pages/index/index.wxss */

/* === 页面根 === */
.page-root {
  min-height: 100vh;
  background: #FDFCF9;
  padding-bottom: 120rpx;
}

/* === 日期选择区 === */
.date-section {
  margin: 20rpx 24rpx 0;
}

.date-trigger {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(28, 28, 28, 0.05);
}

/* 日历小图标 - 纯 CSS */
.date-icon-wrap {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.icon-calendar {
  width: 42rpx;
  height: 42rpx;
  border: 3rpx solid #C5A059;
  border-radius: 6rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.cal-top {
  height: 12rpx;
  background: #C5A059;
}
.cal-body {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 4rpx;
}
.cal-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #8E9775;
}

.date-info {
  flex: 1;
}
.date-label {
  display: block;
  font-size: 20rpx;
  color: #B0A99A;
  margin-bottom: 4rpx;
}
.date-value {
  display: block;
  font-size: 30rpx;
  color: #1C1C1C;
  font-weight: 500;
  letter-spacing: 0.5px;
}

/* 右箭头 */
.icon-chevron-right {
  width: 16rpx;
  height: 16rpx;
  border-right: 2rpx solid #C0BBB4;
  border-bottom: 2rpx solid #C0BBB4;
  transform: rotate(-45deg);
}

/* === 分类导航 === */
.category-scroll {
  margin-top: 24rpx;
  padding: 0 24rpx;
}
.category-list {
  display: flex;
  gap: 24rpx;
  padding-right: 8rpx;
}

.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}
.cat-icon-bg {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}
.cat-icon-img {
  width: 52rpx;
  height: 52rpx;
}
.cat-name {
  font-size: 22rpx;
  color: #6B6660;
  font-weight: 400;
}

/* === 商品区 === */
.products-section {
  margin-top: 32rpx;
  padding: 0 24rpx;
}
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1C;
  letter-spacing: 0.5px;
}
.section-hint {
  font-size: 22rpx;
  color: #C5A059;
}

/* 商品网格 */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

/* 骨架屏占位卡 */
.shimmer-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}
.shimmer-img {
  width: 100%;
  padding-bottom: 133.33%;
}

@keyframes shimmer {
  0%   { background-position: -600rpx 0; }
  100% { background-position: 600rpx 0; }
}
.shimmer {
  background: linear-gradient(90deg, #EEECE8 25%, #E2DED8 50%, #EEECE8 75%);
  background-size: 1200rpx 100%;
  animation: shimmer 1.4s ease-in-out infinite;
}

/* 空状态 */
.empty-box {
  text-align: center;
  padding: 100rpx 0 60rpx;
}
.empty-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.icon-dress {
  width: 80rpx;
  height: 100rpx;
  border: 3rpx solid #D4CFC9;
  border-radius: 0 0 30rpx 30rpx;
  position: relative;
}
.icon-dress::before {
  content: '';
  position: absolute;
  top: -24rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 16rpx;
  border: 2rpx solid #D4CFC9;
  border-radius: 50%;
}
.empty-text {
  font-size: 28rpx;
  color: #B0A99A;
  display: block;
}
.empty-hint {
  font-size: 22rpx;
  color: #C0BBB4;
  display: block;
  margin-top: 8rpx;
}

/* 加载更多 */
.load-footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
}
.load-more-btn {
  font-size: 24rpx;
  color: #C5A059;
  padding: 16rpx 48rpx;
  border: 1rpx solid #C5A059;
  border-radius: 999rpx;
}
.no-more {
  font-size: 22rpx;
  color: #C0BBB4;
  letter-spacing: 2px;
}

/* 加载动效 - 三点 */
.loading-dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #C5A059;
  animation: dotBounce 1.2s ease-in-out infinite both;
}
.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }
@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40%            { transform: scale(1);   opacity: 1; }
}

/* === AI 客服悬浮球 === */
.ai-fab {
  position: fixed;
  right: 32rpx;
  bottom: 180rpx;
  z-index: 500;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.fab-inner {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #1C1C1C;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(28, 28, 28, 0.25);
}
/* 纯 CSS 对话气泡图标 */
.fab-chat-bubble {
  width: 40rpx;
  height: 36rpx;
  border: 3rpx solid #FFFFFF;
  border-radius: 10rpx;
  position: relative;
}
.fab-chat-tail {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 0 solid transparent;
  border-top: 10rpx solid #FFFFFF;
  position: absolute;
  bottom: -13rpx;
  left: 10rpx;
}
.fab-hint {
  font-size: 18rpx;
  color: #6B6660;
  margin-top: 6rpx;
  letter-spacing: 1px;
}
