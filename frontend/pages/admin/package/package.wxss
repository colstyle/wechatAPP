/* pages/admin/package/package.wxss */
.page-root {
  min-height: 100vh;
  background: var(--bg-color, #FDFCF9);
  display: flex;
  flex-direction: column;
}

.admin-header {
  padding: 24rpx 32rpx;
  background: #FFF;
  border-bottom: 1rpx solid #F0F0F0;
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
  z-index: 10;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #F8F8F8;
  height: 72rpx;
  border-radius: 36rpx;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  margin-left: 16rpx;
}

.clear-btn {
  padding: 10rpx;
  color: #CCC;
  font-size: 36rpx;
  line-height: 36rpx;
}

.filter-row {
  display: flex;
  justify-content: flex-start;
  gap: 16rpx;
}

.filter-btn {
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  background: #F8F8F8;
  color: #999;
  font-size: 24rpx;
  transition: all 0.2s;
}

.filter-btn.active {
  background: rgba(197, 160, 89, 0.1);
  color: #C5A059;
  font-weight: 500;
}

.package-list {
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.product-item {
  display: flex;
  background: #FFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
  align-items: center;
}

.product-item .cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #F5F5F5;
  margin-right: 24rpx;
}

.product-item .info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.name-row {
  margin-bottom: 12rpx;
}
.name-row .name {
  font-size: 28rpx;
  color: #1C1C1C;
  font-weight: 500;
}

.price-row {
  font-size: 24rpx;
  display: flex;
  align-items: baseline;
}
.price-row .price-label {
  color: #999;
  margin-right: 8rpx;
}
.price-row .price-val {
  color: #C5A059;
  font-weight: bold;
}

.empty-state {
  min-height: 400rpx;
}
