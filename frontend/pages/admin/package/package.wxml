<view class="container">
  <view class="toolbar">
    <view class="search-bar">
      <icon type="search" size="14"></icon>
      <input type="text" placeholder="搜索衣物名称" bindinput="onSearchInput" value="{{keyword}}" confirm-type="search" bindconfirm="onSearch" />
      <text class="clear-btn" wx:if="{{keyword}}" bindtap="clearSearch">×</text>
    </view>
    <view class="filter-row">
      <view class="filter-item {{eligible === null ? 'active' : ''}}" bindtap="setEligibleFilter" data-eligible="{{null}}">全部</view>
      <view class="filter-item {{eligible === true ? 'active' : ''}}" bindtap="setEligibleFilter" data-eligible="true">参与</view>
      <view class="filter-item {{eligible === false ? 'active' : ''}}" bindtap="setEligibleFilter" data-eligible="false">不参与</view>
    </view>
  </view>

  <scroll-view class="list" scroll-y bindscrolltolower="onLoadMore" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
    <view class="item" wx:for="{{products}}" wx:key="id">
      <image class="cover" src="{{item.cover_image}}" mode="aspectFill"></image>
      <view class="info">
        <text class="name">{{item.name}}</text>
        <text class="sub">押金 ¥{{item.deposit}}</text>
      </view>
      <switch checked="{{item.is_package_eligible}}" data-id="{{item.id}}" bindchange="onToggle"></switch>
    </view>

    <view class="loading" wx:if="{{loading}}">加载中...</view>
    <view class="empty" wx:if="{{!loading && products.length === 0}}">暂无数据</view>
    <view class="no-more" wx:if="{{!hasMore && products.length > 0}}">没有更多了</view>
  </scroll-view>
</view>
