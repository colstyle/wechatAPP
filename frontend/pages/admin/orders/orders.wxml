<!-- pages/admin/orders/orders.wxml -->
<view class="page-root">
  <!-- 自定义导航栏 -->
  <cp-nav-bar title="店主后台" show-back="{{true}}" bg="white"></cp-nav-bar>

  <!-- 核心控制面板 -->
  <view class="dashboard-panel">
    <view class="control-card" bindtap="goToInventoryManage">
      <view class="card-icon-wrap">
        <view class="icon-stock"></view>
      </view>
      <view class="card-text">
        <text class="card-title">库存总管</text>
        <text class="card-sub">上下架及调价</text>
      </view>
      <view class="card-arrow"></view>
    </view>
    <view class="control-card" bindtap="goToPackageManage">
      <view class="card-icon-wrap">
        <view class="icon-pkg-large"></view>
      </view>
      <view class="card-text">
        <text class="card-title">套餐入选池</text>
        <text class="card-sub">配置营销商品</text>
      </view>
      <view class="card-arrow"></view>
    </view>
  </view>

  <view class="admin-header">
    <view class="search-bar">
      <!-- 搜索图标 纯CSS -->
      <view class="icon-search-sm">
        <view class="sc-cir"></view>
        <view class="sc-han"></view>
      </view>
      <input class="search-input" placeholder="搜索单号 / 用户昵称" value="{{keyword}}" bindconfirm="onSearch" confirm-type="search" bindinput="onSearchInput" />
    </view>
  </view>

  <!-- 状态筛选 -->
  <scroll-view class="status-scroll" scroll-x>
    <view class="status-tabs">
      <view class="status-tab {{currentStatus === null ? 'active' : ''}}" bindtap="onStatusChange" data-status="{{null}}">
        <text class="st-text">全部</text>
      </view>
      <view class="status-tab {{currentStatus === 1 ? 'active' : ''}}" bindtap="onStatusChange" data-status="1">待取衣</view>
      <view class="status-tab {{currentStatus === 2 ? 'active' : ''}}" bindtap="onStatusChange" data-status="2">租赁中</view>
      <view class="status-tab {{currentStatus === 3 ? 'active' : ''}}" bindtap="onStatusChange" data-status="3">已逾期</view>
      <view class="status-tab {{currentStatus === 4 ? 'active' : ''}}" bindtap="onStatusChange" data-status="4">待审核</view>
      <view class="status-tab {{currentStatus === 7 ? 'active' : ''}}" bindtap="onStatusChange" data-status="7">已完成</view>
    </view>
  </scroll-view>

  <!-- 订单列表 -->
  <scroll-view class="order-list" scroll-y bindscrolltolower="onLoadMore" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
    <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      
      <view class="oc-header">
        <view class="oc-no">
          <text class="oc-hash">#</text>
          <text>{{item.order_no}}</text>
        </view>
        <view class="oc-status status-{{item.status}}">{{item.status_text}}</view>
      </view>

      <view class="oc-body">
        <view class="user-avatar-wrap">
          <image class="user-avatar" src="{{item.avatar || ''}}" mode="aspectFill"></image>
          <!-- 默认用户纯CSS -->
          <view class="avatar-placeholder" wx:if="{{!item.avatar}}">
            <view class="icon-person-sm"></view>
          </view>
        </view>
        <view class="oc-info">
          <text class="user-name">{{item.nickname || '微信用户'}}</text>
          <text class="order-time">{{item.created_at}}</text>
        </view>
        <view class="oc-price">
          <text class="op-sym">¥</text>
          <text class="op-num">{{item.total_amount}}</text>
        </view>
      </view>

    </view>

    <view class="loading-state" wx:if="{{loading}}">
      <view class="loading-dots"><view class="dot"></view><view class="dot"></view><view class="dot"></view></view>
    </view>
    <view class="no-more" wx:if="{{!hasMore && orders.length > 0}}">没有更多订单了</view>
    
    <view class="empty-state" wx:if="{{!loading && orders.length === 0}}">
      <view class="icon-empty-doc">
        <view class="doc-line"></view><view class="doc-line short"></view>
      </view>
      <text class="empty-text">暂无相关订单</text>
    </view>
  </scroll-view>

</view>
