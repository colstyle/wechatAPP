.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f8f8f8;
}

/* 搜索栏 */
.search-section {
  padding: 20rpx;
  background-color: #fff;
}

.admin-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.action-btn {
  padding: 12rpx 20rpx;
  border-radius: 18rpx;
  background: #ff6b6b;
  color: #fff;
  font-size: 24rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  padding: 15rpx 25rpx;
  border-radius: 40rpx;
  position: relative;
}

.search-bar icon {
  margin-right: 15rpx;
}

.search-bar input {
  flex: 1;
  font-size: 28rpx;
}

.clear-btn {
  padding: 10rpx;
  font-size: 36rpx;
  color: #999;
}

/* 状态筛选 */
.status-scroll {
  background-color: #fff;
  border-bottom: 1px solid #eee;
  white-space: nowrap;
}

.status-tabs {
  display: inline-flex;
  padding: 0 20rpx;
}

.status-tab {
  padding: 25rpx 30rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.status-tab.active {
  color: #ff6b6b;
  font-weight: bold;
}

.status-tab.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 20%;
  width: 60%;
  height: 4rpx;
  background-color: #ff6b6b;
  border-radius: 2rpx;
}

/* 订单列表 */
.order-list {
  flex: 1;
  padding: 20rpx;
}

.order-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1px solid #f5f5f5;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.status-text {
  font-size: 26rpx;
  font-weight: bold;
}

.status-0 { color: #faad14; } /* 待支付 */
.status-1 { color: #1890ff; } /* 待取衣 */
.status-2 { color: #52c41a; } /* 租赁中 */
.status-3 { color: #f5222d; } /* 已逾期 */
.status-4 { color: #722ed1; } /* 待审核 */
.status-7 { color: #bfbfbf; } /* 已完成 */

.card-body {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #f5f5f5;
}

.order-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.order-time {
  font-size: 22rpx;
  color: #999;
}

.order-amount {
  text-align: right;
  display: flex;
  flex-direction: column;
}

.amount-label {
  font-size: 20rpx;
  color: #999;
}

.amount-value {
  font-size: 32rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.loading-status, .no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
