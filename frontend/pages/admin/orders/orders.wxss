/* pages/admin/orders/orders.wxss */

.page-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FDFCF9;
}

/* === 顶部栏 === */
.admin-header {
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #FFFFFF;
}
.search-bar {
  flex: 1;
  height: 72rpx;
  background: rgba(238, 236, 232, 0.4);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}
/* 搜索放大镜纯CSS */
.icon-search-sm {
  position: relative; width: 24rpx; height: 24rpx; margin-right: 12rpx;
}
.sc-cir {
  width: 18rpx; height: 18rpx;
  border: 2rpx solid #B0A99A; border-radius: 50%;
  position: absolute; top:0; left:0;
}
.sc-han {
  width: 2rpx; height: 8rpx; background: #B0A99A;
  position: absolute; bottom:-2rpx; right: 2rpx; transform: rotate(-45deg);
}
.search-input {
  flex: 1; font-size: 26rpx; color: #1C1C1C;
}

/* === 核心控制面板 === */
.dashboard-panel {
  padding: 32rpx 24rpx 12rpx 24rpx;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  background: #FFFFFF;
}
.control-card {
  flex: 1;
  background: linear-gradient(135deg, #FDFCF9 0%, #F8F5EE 100%);
  border: 1rpx solid rgba(197,160,89, 0.15);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
}
.card-icon-wrap {
  width: 72rpx; height: 72rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  margin-right: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(197,160,89, 0.08);
}
/* 纯CSS库存图标 */
.icon-stock {
  width: 28rpx; height: 34rpx; border: 3rpx solid #C5A059; border-radius: 4rpx;
  position: relative; box-sizing: border-box;
}
.icon-stock::after {
  content: ''; position: absolute; bottom: 4rpx; left: 4rpx; right: 4rpx; height: 6rpx; background: #C5A059; border-radius: 2rpx;
}
/* 纯CSS套餐图标大 */
.icon-pkg-large {
  width: 32rpx; height: 32rpx; border: 3rpx solid #C5A059; border-radius: 6rpx;
  position: relative; box-sizing: border-box;
}
.icon-pkg-large::after {
  content: ''; position: absolute; left: 50%; top: -3rpx; bottom: -3rpx; width: 3rpx; background: #C5A059; transform: translateX(-50%);
}
.icon-pkg-large::before {
  content: ''; position: absolute; top: 50%; left: -3rpx; right: -3rpx; height: 3rpx; background: #C5A059; transform: translateY(-50%);
}

.card-text {
  display: flex; flex-direction: column; z-index: 1;
}
.card-title {
  font-size: 28rpx; color: #1C1C1C; font-weight: 600; margin-bottom: 6rpx;
}
.card-sub {
  font-size: 20rpx; color: #8E877F;
}
.card-arrow {
  position: absolute; right: 24rpx; top: 50%; width: 10rpx; height: 10rpx;
  border-top: 3rpx solid #C5A059; border-right: 3rpx solid #C5A059;
  transform: translateY(-50%) rotate(45deg); opacity: 0.6;
}

/* === 状态分类区 === */
.status-scroll {
  width: 100%;
  white-space: nowrap;
  background: #FFFFFF;
  border-bottom: 1rpx solid rgba(28,28,28,0.04);
}
.status-tabs {
  display: inline-flex;
  padding: 0 12rpx;
}
.status-tab {
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #8E877F;
  position: relative;
  transition: all 0.2s;
}
.status-tab.active {
  color: #1C1C1C;
  font-weight: 600;
}
.status-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0; left: 50%; transform: translateX(-50%);
  width: 40rpx; height: 6rpx;
  background: #C5A059;
  border-radius: 3rpx 3rpx 0 0;
}

/* === 订单列表区 === */
.order-list {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 订单卡片 */
.order-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(28,28,28,0.03);
}
.oc-header {
  display: flex; justify-content: space-between; align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(28,28,28,0.04);
  margin-bottom: 24rpx;
}
.oc-no { font-size: 26rpx; color: #1C1C1C; font-weight: 500; }
.oc-hash { color: #B0A99A; margin-right: 4rpx; }

/* 状态色 */
.oc-status { font-size: 24rpx; font-weight: 600; }
.status-0 { color: #8E877F; }
.status-1, .status-2 { color: #8E9775; }
.status-3 { color: #C5A059; } 
.status-4, .status-5, .status-6 { color: #B05B5B; }
.status-7 { color: #8E877F; }

.oc-body {
  display: flex; align-items: center; gap: 24rpx;
}
.user-avatar-wrap {
  width: 80rpx; height: 80rpx; position: relative; border-radius: 50%; overflow: hidden; background: #F5F4F0; flex-shrink:0;
}
.user-avatar { width: 100%; height: 100%; }
.avatar-placeholder {
  position: absolute; inset:0; display:flex; align-items:center; justify-content:center;
}
.icon-person-sm {
  width: 24rpx; height: 24rpx; border: 2rpx solid #C0BBB4; border-radius: 50% 50% 0 0; position: relative;
}
.icon-person-sm::after {
  content: ''; position: absolute; bottom:-10rpx; left:-6rpx; right:-6rpx; height:10rpx; border:2rpx solid #C0BBB4; border-bottom:none; border-radius: 50% 50% 0 0;
}

.oc-info { flex: 1; min-width: 0; }
.user-name { display: block; font-size: 28rpx; color: #1C1C1C; font-weight: 500; margin-bottom: 8rpx; }
.order-time { display: block; font-size: 22rpx; color: #B0A99A; }

.oc-price { text-align: right; }
.op-sym { font-size: 22rpx; color: #1C1C1C; font-weight: 500; }
.op-num { font-size: 32rpx; color: #1C1C1C; font-weight: 600; }

/* 空与加载态 */
.loading-state, .empty-state {
  display: flex; justify-content: center; align-items: center; padding: 60rpx 0;
}
.empty-state { flex-direction: column; padding-top: 120rpx; }
.no-more { text-align: center; font-size: 24rpx; color: #C0BBB4; padding: 30rpx 0; }
/* 纯CSS 文档图标 */
.icon-empty-doc {
  width: 60rpx; height: 80rpx; border: 3rpx solid #D4CFC9; border-radius: 6rpx;
  position: relative; margin-bottom: 24rpx; padding: 20rpx 10rpx; box-sizing: border-box;
  display: flex; flex-direction: column; gap: 10rpx;
}
.doc-line { width: 100%; height: 3rpx; background: #D4CFC9; border-radius: 2rpx;}
.doc-line.short { width: 60%; }
.empty-text { font-size: 26rpx; color: #B0A99A; }

/* dotBounce 同前 */
.loading-dots { display: flex; gap: 8rpx; }
.dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #C5A059; animation: dotBounce 1.2s infinite ease-in-out both; }
.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }
@keyframes dotBounce { 0%,80%,100% { transform: scale(0.6); opacity: 0.4; } 40% { transform: scale(1); opacity: 1; } }
