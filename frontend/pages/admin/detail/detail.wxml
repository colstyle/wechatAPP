<view class="container">
  <view class="section" wx:if="{{order}}">
    <view class="section-title">订单详情</view>
    <view class="info-row">
      <text class="label">订单号:</text>
      <text class="value">{{order.order_no}}</text>
    </view>
    <view class="info-row">
      <text class="label">下单用户:</text>
      <text class="value">{{order.nickname}}</text>
    </view>
    <view class="info-row">
      <text class="label">当前状态:</text>
      <text class="value status status-{{order.status}}">{{order.status_text}}</text>
    </view>
    <view class="info-row">
      <text class="label">实付总额:</text>
      <text class="value price">¥{{order.total_amount}}</text>
    </view>
    <view class="info-row">
      <text class="label">其中押金:</text>
      <text class="value">¥{{order.total_deposit}}</text>
    </view>
    <view class="info-row" wx:if="{{order.pickup_time}}">
      <text class="label">取衣时间:</text>
      <text class="value">{{order.pickup_time}}</text>
    </view>
    <view class="info-row" wx:if="{{order.overdue_duration}}">
      <text class="label">逾期时长:</text>
      <text class="value danger">{{order.overdue_duration}} 小时</text>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="section" wx:if="{{order}}">
    <view class="section-title">租赁衣物</view>
    <view class="product-item" wx:for="{{order.items}}" wx:key="id">
      <image class="product-img" src="{{item.product_image}}" mode="aspectFill"></image>
      <view class="product-info">
        <text class="product-name">{{item.product_name}}</text>
        <text class="product-spec">{{item.size}} / {{item.color}}</text>
        <text class="product-deposit">押金: ¥{{item.deposit}}</text>
      </view>
    </view>
  </view>

  <!-- 管理操作区 -->
  <view class="admin-actions" wx:if="{{order}}">
    <!-- 待取衣状态可修改衣物 (换款) -->
    <button class="btn btn-outline" wx:if="{{order.status === 1}}" bindtap="onUpdateItems">手动修改衣物(换款)</button>
    
    <!-- 待审核状态可一键退押金 -->
    <button class="btn btn-primary btn-lg" wx:if="{{order.status === 4}}" bindtap="onRefund">一键原路退押金</button>
    
    <!-- 租赁中、逾期、已归还均可执行扣费 -->
    <button class="btn btn-danger btn-lg" wx:if="{{order.status >= 2 && order.status <= 4}}" bindtap="onDeduct">手动扣除押金</button>
  </view>

  <!-- 退款/扣款弹窗 -->
  <view class="modal" wx:if="{{showModal}}">
    <view class="modal-content">
      <view class="modal-header">{{modalTitle}}</view>
      <view class="modal-body">
        <view class="input-group">
          <text class="input-label">金额 (元):</text>
          <input class="input" type="digit" placeholder="输入金额" bindinput="onModalAmountInput" value="{{modalAmount}}" />
        </view>
        <view class="input-group">
          <text class="input-label">原因:</text>
          <textarea class="textarea" placeholder="输入说明内容" bindinput="onModalReasonInput" value="{{modalReason}}"></textarea>
        </view>
      </view>
      <view class="modal-footer">
        <button class="modal-btn cancel" bindtap="closeModal">取消</button>
        <button class="modal-btn confirm" bindtap="confirmModal">提交</button>
      </view>
    </view>
  </view>

  <view class="loading-state" wx:if="{{loading}}">
    <text>数据加载中...</text>
  </view>
</view>
