.container {
  padding: 20rpx;
  background-color: #f7f7f7;
  min-height: 100vh;
}

.section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.10);
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.label {
  color: #666;
}

.value {
  color: #333;
}

.price {
  color: #ff6b6b;
  font-weight: 600;
}

.danger {
  color: #f5222d;
  font-weight: bold;
}

.product-item {
  display: flex;
  margin-bottom: 30rpx;
}

.product-img {
  width: 150rpx;
  height: 200rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.product-spec {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.product-deposit {
  font-size: 24rpx;
  color: #666;
}

.admin-actions {
  display: flex;
  flex-direction: column;
  padding: 0;
}

.btn {
  margin-bottom: 20rpx;
  width: 100%;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: #fff;
  width: 80%;
  border-radius: 16rpx;
  padding: 20rpx;
}

.modal-header {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 16rpx;
}

.input-group {
  margin-bottom: 20rpx;
}

.input-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.input {
  border: 1rpx solid #eeeeee;
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
  background: #f7f7f7;
}

.textarea {
  border: 1rpx solid #eeeeee;
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
  height: 200rpx;
  width: 100%;
  background: #f7f7f7;
}

.modal-footer {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.modal-btn {
  flex: 1;
}

.modal-btn.cancel {
  background-color: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background-color: #ff6b6b;
  color: #fff;
}

.loading-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}
