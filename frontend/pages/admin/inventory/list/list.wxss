/* pages/admin/inventory/list/list.wxss */
.page-root { 
  height: 100vh; 
  display: flex;
  flex-direction: column;
  background: #F8F9F9; 
}

.admin-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #EAEAEA;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 36rpx;
  padding: 12rpx 24rpx;
  flex: 1;
}

.icon-search-sm {
  width: 24rpx;
  height: 24rpx;
  position: relative;
  margin-right: 12rpx;
}
.sc-cir {
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #999;
  border-radius: 50%;
  box-sizing: border-box;
}
.sc-han {
  width: 8rpx;
  height: 3rpx;
  background: #999;
  position: absolute;
  bottom: 1rpx;
  right: -2rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.btn-add {
  background: #C5A059;
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 36rpx;
  font-weight: 500;
}

.product-list {
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.product-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  margin-bottom: 24rpx;
}

.cover {
  width: 160rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #F0F0F0;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.name-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
  flex: 1;
  margin-right: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.tag-status {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.status-up {
  background: rgba(197, 160, 89, 0.1);
  color: #C5A059;
}

.status-down {
  background: #F5F5F5;
  color: #999;
}

.price-row {
  margin-top: 12rpx;
  display: flex;
  align-items: bottom;
  font-size: 22rpx;
}
.price-label {
  color: #666;
  margin-right: 8rpx;
}
.price-val {
  color: #D32F2F;
  font-weight: 500;
}
.ml {
  margin-left: 24rpx;
}

.stats-row {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
  display: flex;
}

.action-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.btn-outline {
  border: 1rpx solid #EAEAEA;
  color: #333;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 32rpx;
  margin-left: 16rpx;
}

.btn-outline.danger {
  color: #D32F2F;
  border-color: #FFCDD2;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* Loading */
.loading-state { display: flex; justify-content: center; padding: 20rpx 0; }
.loading-dots { display: flex; align-items: center; }
.dot { width: 12rpx; height: 12rpx; background-color: #C5A059; border-radius: 50%; margin: 0 6rpx; animation: bounce 1.4s infinite ease-in-out both; }
.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }
@keyframes bounce { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1); } }
.no-more { text-align: center; font-size: 24rpx; color: #bbb; padding: 30rpx 0; }
