/* pages/address/address.wxss */
.page {
  background: #f8f9fa;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 地址列表 */
.address-list {
  padding: 24rpx;
}

.address-card {
  background: #fff;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

/* 地址头部 */
.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.address-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #212529;
  margin-right: 16rpx;
}

.address-phone {
  font-size: 28rpx;
  color: #6c757d;
  margin-right: auto;
}

.default-badge {
  background: #ff6b6b;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

/* 地址内容 */
.address-content {
  margin-bottom: 24rpx;
}

.address-region {
  display: block;
  font-size: 26rpx;
  color: #495057;
  margin-bottom: 8rpx;
}

.address-detail {
  display: block;
  font-size: 26rpx;
  color: #6c757d;
  line-height: 1.5;
}

/* 地址底部 */
.address-footer {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

/* 按钮样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  border: none;
  background: none;
}

.btn-primary {
  background: #ff6b6b;
  color: #fff;
}

.btn-outline {
  border: 1rpx solid #ff6b6b;
  color: #ff6b6b;
  background: #fff;
}

.btn-danger {
  background: #f8d7da;
  color: #721c24;
}

.btn-sm {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #adb5bd;
  font-size: 28rpx;
}

/* 加载中 */
.loading {
  padding: 48rpx;
  text-align: center;
  color: #adb5bd;
  font-size: 28rpx;
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.1);
}

.footer-btn {
  padding: 20rpx 48rpx;
  width: 100%;
}
