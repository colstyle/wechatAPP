/* pages/profile/profile.wxss */

.page-root {
  min-height: 100vh;
  background: #FDFCF9;
  padding-bottom: 60rpx;
}

.content {
  padding: 20rpx 24rpx 0;
}

/* === 用户信息卡 === */
.user-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(28,28,28,0.04);
}
.avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}
.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #EEECE8;
}
.avatar-placeholder {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: rgba(197,160,89,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 纯 CSS 人形 */
.icon-person {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #C5A059;
  border-radius: 50% 50% 0 0;
  position: relative;
}
.icon-person::after {
  content: '';
  position: absolute;
  bottom: -14rpx;
  left: -8rpx;
  right: -8rpx;
  height: 14rpx;
  border: 3rpx solid #C5A059;
  border-radius: 50% 50% 0 0;
  border-bottom: none;
}

.user-meta { flex: 1; min-width: 0; }
.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1C1C1C;
  display: block;
}
.user-sub {
  font-size: 22rpx;
  color: #B0A99A;
  display: block;
  margin-top: 6rpx;
}
/* 右箭头 */
.user-chevron {
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid #C0BBB4;
  border-bottom: 2rpx solid #C0BBB4;
  transform: rotate(-45deg);
  flex-shrink: 0;
}

/* === 订单速览 === */
.order-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(28,28,28,0.04);
}
.oc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.oc-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1C;
}
.oc-all {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.oc-all-text { font-size: 22rpx; color: #C5A059; }
.oc-all-arrow {
  width: 10rpx;
  height: 10rpx;
  border-right: 1.5rpx solid #C5A059;
  border-bottom: 1.5rpx solid #C5A059;
  transform: rotate(-45deg);
}

.order-shortcuts {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}
.os-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  position: relative;
}
.os-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.os-blue    { background: rgba(122,143,166,0.12); }
.os-gold    { background: rgba(197,160,89,0.12); }
.os-sage    { background: rgba(142,151,117,0.12); }
.os-neutral { background: rgba(28,28,28,0.05); }

.os-label { font-size: 20rpx; color: #8E877F; }
.os-badge {
  position: absolute;
  top: -4rpx;
  right: 4rpx;
  background: #B05B5B;
  border-radius: 999rpx;
  min-width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 4rpx;
  font-size: 16rpx;
  color: #FFF;
  font-weight: 600;
}

/* ── 快捷图标（小号版） ── */
/* 衣架 */
.icon-hanger-sm {
  width: 36rpx;
  height: 32rpx;
  position: relative;
  border: 2rpx solid #7A8FA6;
  border-top: none;
  border-radius: 0 0 3rpx 3rpx;
}
.icon-hanger-sm::before {
  content: '';
  position: absolute;
  top: -14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 1rpx;
  border-top: 2rpx solid #7A8FA6;
}
.icon-hanger-sm::after {
  content: '';
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  border: 2rpx solid #7A8FA6;
  border-radius: 50%;
}

/* 时钟 */
.icon-clock-sm {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #C5A059;
  border-radius: 50%;
  position: relative;
}
.icon-clock-sm::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 2rpx;
  height: 9rpx;
  background: #C5A059;
  border-radius: 1rpx;
}
.icon-clock-sm::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 9rpx;
  height: 2rpx;
  background: #C5A059;
  transform: translate(-50%,-50%) rotate(30deg);
  transform-origin: left center;
  border-radius: 1rpx;
}

/* 返回箭头 */
.icon-return-sm {
  width: 28rpx;
  height: 22rpx;
  position: relative;
}
.icon-return-sm::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 4rpx;
  width: 22rpx;
  height: 2rpx;
  background: #8E9775;
  border-radius: 1rpx;
}
.icon-return-sm::after {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 4rpx;
  width: 12rpx;
  height: 12rpx;
  border-left: 2rpx solid #8E9775;
  border-top: 2rpx solid #8E9775;
  transform: rotate(-45deg);
}

/* 完成勾 */
.icon-check-sm {
  width: 22rpx;
  height: 16rpx;
  border-right: 2.5rpx solid #B0A99A;
  border-bottom: 2.5rpx solid #B0A99A;
  transform: rotate(45deg);
  margin-top: -6rpx;
}

/* === 服务菜单 === */
.menu-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(28,28,28,0.04);
}
.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(28,28,28,0.05);
}
.menu-item.last { border-bottom: none; }
.menu-item.admin-item { }

.mi-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.mi-gold    { background: rgba(197,160,89,0.12); }
.mi-neutral { background: rgba(28,28,28,0.05); }
.mi-dark    { background: rgba(28,28,28,0.08); }

.mi-text {
  flex: 1;
  font-size: 28rpx;
  color: #1C1C1C;
}
.mi-tag {
  font-size: 18rpx;
  color: #C5A059;
  background: rgba(197,160,89,0.12);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}
.admin-tag {
  color: #1C1C1C;
  background: rgba(28,28,28,0.07);
}
.mi-arrow {
  width: 12rpx;
  height: 12rpx;
  border-right: 1.5rpx solid #C0BBB4;
  border-bottom: 1.5rpx solid #C0BBB4;
  transform: rotate(-45deg);
  flex-shrink: 0;
}

/* ── 服务图标 ── */
/* AI 对话气泡 */
.icon-chat-m {
  position: relative;
  width: 36rpx;
  height: 34rpx;
}
.chat-bubble {
  width: 36rpx;
  height: 28rpx;
  border: 2.5rpx solid #C5A059;
  border-radius: 10rpx;
  position: absolute;
  top: 0;
}
.chat-tail {
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-top: 7rpx solid #C5A059;
  position: absolute;
  bottom: 0;
  left: 10rpx;
}

/* 设置齿轮 */
.icon-setting {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.setting-ring {
  width: 28rpx;
  height: 28rpx;
  border: 2.5rpx solid #B0A99A;
  border-radius: 50%;
}
.setting-dot {
  width: 10rpx;
  height: 10rpx;
  background: #B0A99A;
  border-radius: 50%;
  position: absolute;
}

/* 店铺 */
.icon-store {
  position: relative;
  width: 36rpx;
  height: 34rpx;
}
.store-roof {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 10rpx;
  border: 2rpx solid #1C1C1C;
  border-bottom: none;
  border-radius: 3rpx 3rpx 0 0;
}
.store-body {
  position: absolute;
  bottom: 0;
  left: 4rpx;
  right: 4rpx;
  height: 22rpx;
  border: 2rpx solid #1C1C1C;
  border-radius: 0 0 3rpx 3rpx;
}

/* === 退出按钮 === */
.logout-btn {
  background: #FFFFFF;
  border-radius: 24rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(28,28,28,0.04);
}
.logout-text {
  font-size: 28rpx;
  color: #B05B5B;
  font-weight: 500;
}
