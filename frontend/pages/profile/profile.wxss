/* pages/profile/profile.wxss */
.page {
  min-height: 100vh;
  background-color: #f8f9fa;
  padding-bottom: 40rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* 用户信息区 */
.user-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 30rpx 40rpx;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  margin-right: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.arrow-icon {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
}

/* 订阅信息 */
.subscription-info {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
}

.subscription-badge {
  margin-bottom: 12rpx;
}

.badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.badge.active {
  background: linear-gradient(135deg, #ff6b6b, #ff8787);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}

.subscription-detail {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.subscription-detail text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.subscription-days {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 订单状态栏 */
.order-bar {
  background-color: #fff;
  margin: 20rpx 24rpx;
  padding: 30rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.06);
}

.order-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #212529;
  margin-bottom: 30rpx;
  position: relative;
  padding-left: 24rpx;
}

.order-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #ff6b6b, #ff8787);
  border-radius: 4rpx;
}

.order-tabs {
  display: flex;
  justify-content: space-around;
}

.order-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  padding: 10rpx 0;
}

.order-icon {
  font-size: 52rpx;
  margin-bottom: 12rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.order-text {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.order-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff8787);
  color: #fff;
  font-size: 20rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  box-shadow: 0 4rpx 10rpx rgba(255, 107, 107, 0.4);
}

/* 功能列表 */
.function-section {
  margin: 20rpx 24rpx;
}

.function-group {
  background-color: #fff;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.function-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
  transition: background-color 0.2s;
}

.function-item:active {
  background-color: #fafafa;
}

.function-item:last-child {
  border-bottom: none;
}

.function-item::before {
  content: '';
  position: absolute;
  left: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  opacity: 0;
  transition: opacity 0.2s;
}

.function-item:hover::before {
  opacity: 1;
}

.item-left {
  display: flex;
  align-items: center;
  margin-left: 0;
}

.item-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.item-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.function-item .arrow-icon {
  font-size: 28rpx;
  color: #ccc;
  font-weight: 300;
}

/* 退出登录 */
.logout-section {
  margin: 40rpx 24rpx;
}

.btn-logout {
  width: 100%;
  height: 96rpx;
  background: #fff;
  color: #ff6b6b;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 24rpx;
  border: 2rpx solid #ff6b6b;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 96rpx;
  padding: 0;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.15);
  transition: all 0.2s;
}

.btn-logout:active {
  background: #ff6b6b;
  color: #fff;
}

.btn-logout::after {
  border: none;
}
