<!--pages/profile/profile.wxml-->
<view class="page">
  <!-- 用户信息区 -->
  <view class="user-section">
    <view class="user-info" bindtap="handleLogin">
      <image class="user-avatar" src="{{userInfo.avatar || ''}}" mode="aspectFill"></image>
      <view class="user-detail">
        <text class="user-name">{{userInfo.nickname || '点击登录'}}</text>
        <text class="user-id" wx:if="{{userInfo.openid}}">ID: {{userInfo.openid.substring(0, 8)}}</text>
      </view>
      <text class="arrow-icon">></text>
    </view>

    <!-- 订阅信息 -->
    <view class="subscription-info" wx:if="{{activeSubscription}}">
      <view class="subscription-badge">
        <text class="badge active">{{activeSubscription.package_name}}会员</text>
      </view>
      <view class="subscription-detail">
        <text>剩余次数: {{activeSubscription.remaining_times || '不限'}}</text>
        <text class="subscription-days">{{activeSubscription.end_date}}到期</text>
      </view>
    </view>
  </view>

  <!-- 订单状态栏 -->
  <view class="order-bar">
    <view class="order-title">我的订单</view>
    <view class="order-tabs">
      <view class="order-tab" bindtap="onOrdersTap" data-status="0">
        <text class="order-icon">💰</text>
        <text class="order-text">待付款</text>
        <text class="order-badge" wx:if="{{orderStats.pending}}">{{orderStats.pending}}</text>
      </view>
      <view class="order-tab" bindtap="onOrdersTap" data-status="1">
        <text class="order-icon">📦</text>
        <text class="order-text">待发货</text>
        <text class="order-badge" wx:if="{{orderStats.shipping}}">{{orderStats.shipping}}</text>
      </view>
      <view class="order-tab" bindtap="onOrdersTap" data-status="2">
        <text class="order-icon">👗</text>
        <text class="order-text">租赁中</text>
        <text class="order-badge" wx:if="{{orderStats.renting}}">{{orderStats.renting}}</text>
      </view>
      <view class="order-tab" bindtap="onOrdersTap" data-status="3">
        <text class="order-icon">🔄</text>
        <text class="order-text">待归还</text>
        <text class="order-badge" wx:if="{{orderStats.returning}}">{{orderStats.returning}}</text>
      </view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="function-section">
    <view class="function-group">
      <view class="function-item" bindtap="onAddressTap">
        <view class="item-left">
          <text class="item-icon">📍</text>
          <text class="item-text">收货地址</text>
        </view>
        <text class="arrow-icon">></text>
      </view>
      <view class="function-item" bindtap="onAppointmentTap">
        <view class="item-left">
          <text class="item-icon">📅</text>
          <text class="item-text">预约试穿</text>
        </view>
        <text class="arrow-icon">></text>
      </view>
      <view class="function-item" bindtap="onSubscribeTap">
        <view class="item-left">
          <text class="item-icon">👑</text>
          <text class="item-text">我的订阅</text>
        </view>
        <text class="arrow-icon">></text>
      </view>
      <view class="function-item" bindtap="onFavoritesTap">
        <view class="item-left">
          <text class="item-icon">❤️</text>
          <text class="item-text">我的收藏</text>
        </view>
        <text class="arrow-icon">></text>
      </view>
    </view>

    <view class="function-group">
      <view class="function-item" bindtap="onReviewsTap">
        <view class="item-left">
          <text class="item-icon">⭐</text>
          <text class="item-text">我的评价</text>
        </view>
        <text class="arrow-icon">></text>
      </view>
      <view class="function-item" bindtap="onFeedbackTap">
        <view class="item-left">
          <text class="item-icon">💬</text>
          <text class="item-text">意见反馈</text>
        </view>
        <text class="arrow-icon">></text>
      </view>
      <view class="function-item" bindtap="onSettingsTap">
        <view class="item-left">
          <text class="item-icon">⚙️</text>
          <text class="item-text">设置</text>
        </view>
        <text class="arrow-icon">></text>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{userInfo.nickname}}">
    <button class="btn-logout" bindtap="onLogout">退出登录</button>
  </view>
</view>
