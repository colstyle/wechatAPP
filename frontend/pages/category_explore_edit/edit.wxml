<view class="page-root">
  <cp-nav-bar title="分类页编辑" show-back="{{true}}" bg="white"></cp-nav-bar>

  <view class="top-actions">
    <view class="btn" bindtap="addGroup">+ 新增分组</view>
    <view class="btn primary" bindtap="save" loading="{{saving}}">保存</view>
  </view>

  <scroll-view class="content" scroll-y>
    <view class="group-card" wx:for="{{groups}}" wx:key="id">
      <view class="group-head">
        <text class="g-title">{{item.emoji || ''}} {{item.name}}</text>
        <view class="g-actions">
          <view class="btn-mini" bindtap="moveGroupUp" data-index="{{index}}" wx:if="{{index>0}}">上移</view>
          <view class="btn-mini" bindtap="moveGroupDown" data-index="{{index}}" wx:if="{{index<groups.length-1}}">下移</view>
          <view class="btn-mini" bindtap="editGroup" data-index="{{index}}">编辑</view>
          <view class="btn-mini danger" bindtap="deleteGroup" data-index="{{index}}">删除</view>
        </view>
      </view>

      <view class="items">
        <view class="item-row" wx:for="{{item.items}}" wx:key="id">
          <text class="i-name">{{item.emoji || ''}} {{item.name}}</text>
          <view class="i-actions">
            <view class="btn-mini" bindtap="moveItemUp" data-gindex="{{index}}" data-iindex="{{index2}}" wx:if="{{index2>0}}">上移</view>
            <view class="btn-mini" bindtap="moveItemDown" data-gindex="{{index}}" data-iindex="{{index2}}" wx:if="{{index2<item.items.length-1}}">下移</view>
            <view class="btn-mini" bindtap="editItem" data-gindex="{{index}}" data-iindex="{{index2}}">编辑</view>
            <view class="btn-mini danger" bindtap="deleteItem" data-gindex="{{index}}" data-iindex="{{index2}}">删除</view>
          </view>
        </view>
        <view class="add-item" bindtap="addItem" data-index="{{index}}">+ 新增入口</view>
      </view>
    </view>

    <view class="empty" wx:if="{{groups.length===0}}">
      <text>当前没有任何内容</text>
    </view>

    <view style="height: 80rpx;"></view>
  </scroll-view>
</view>
