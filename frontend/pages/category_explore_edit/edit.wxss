.page-root {
  height: 100vh;
  background: #FDFCF9;
}

.top-actions {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid rgba(28, 28, 28, 0.04);
}

.btn {
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  border: 1rpx solid #E7E2DA;
  font-size: 26rpx;
  color: #2E2B26;
}

.btn.primary {
  background: #2E2B26;
  color: #FFFFFF;
  border-color: #2E2B26;
}

.content {
  height: calc(100vh - 180rpx);
  padding: 18rpx 24rpx;
}

.group-card {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.group-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.g-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2E2B26;
}

.g-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  justify-content: flex-end;
}

.btn-mini {
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid #E7E2DA;
  font-size: 22rpx;
  color: #2E2B26;
}

.btn-mini.danger {
  border-color: #E6B8B8;
  color: #B94A48;
}

.items {
  margin-top: 14rpx;
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(231, 226, 218, 0.7);
}

.i-name {
  font-size: 26rpx;
  color: #2E2B26;
  flex: 1;
}

.i-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  justify-content: flex-end;
}

.add-item {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  border: 1rpx dashed #E7E2DA;
  font-size: 24rpx;
  color: #8E9775;
  text-align: center;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #9A958B;
}

