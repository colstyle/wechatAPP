<view class="page-root">
  <cp-nav-bar title="商品分类" show-back="{{true}}" bg="white"></cp-nav-bar>

  <view class="content-body">
    <scroll-view class="sidebar" scroll-y>
      <view
        class="sidebar-item {{activeId === item.id ? 'active' : ''}}"
        wx:for="{{parents}}"
        wx:key="id"
        bindtap="onParentTap"
        data-id="{{item.id}}"
      >
        <view class="active-bar" wx:if="{{activeId === item.id}}"></view>
        <text class="sidebar-name">{{item.icon || ''}} {{item.name}}</text>
      </view>
    </scroll-view>

    <scroll-view class="main" scroll-y>
      <view class="header">
        <text class="title">{{activeName}}</text>
      </view>

      <view class="grid" wx:if="{{children.length > 0}}">
        <view class="grid-item" wx:for="{{children}}" wx:key="id" bindtap="goToProducts" data-id="{{item.id}}" data-name="{{item.name}}">
          <view class="grid-inner">
            <text class="grid-name">{{item.icon || ''}} {{item.name}}</text>
          </view>
        </view>
      </view>

      <view class="empty" wx:if="{{!loading && children.length === 0}}">
        <text>该分类暂无子分类</text>
      </view>

      <view class="loading" wx:if="{{loading}}">
        <text>加载中...</text>
      </view>
    </scroll-view>
  </view>
</view>
