.page-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FDFCF9;
}

.content-body {
  flex: 1;
  display: flex;
}

.sidebar {
  width: 220rpx;
  background: #FFFFFF;
  border-right: 1rpx solid rgba(28, 28, 28, 0.04);
}

.sidebar-item {
  padding: 22rpx 18rpx;
  position: relative;
}

.sidebar-item.active {
  background: rgba(197, 160, 89, 0.08);
}

.active-bar {
  position: absolute;
  left: 0;
  top: 20rpx;
  bottom: 20rpx;
  width: 6rpx;
  background: #C5A059;
  border-radius: 6rpx;
}

.sidebar-name {
  font-size: 26rpx;
  color: #2E2B26;
}

.main {
  flex: 1;
  padding: 18rpx 18rpx 24rpx;
}

.header {
  padding: 8rpx 6rpx 18rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2E2B26;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grid-item {
  width: calc(50% - 8rpx);
}

.grid-inner {
  background: #FFFFFF;
  border: 1rpx solid rgba(231, 226, 218, 0.9);
  border-radius: 16rpx;
  padding: 22rpx 18rpx;
}

.grid-name {
  font-size: 26rpx;
  color: #2E2B26;
  font-weight: 600;
}

.empty, .loading {
  padding: 60rpx 0;
  text-align: center;
  color: #9A958B;
}
