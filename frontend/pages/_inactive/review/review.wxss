/* pages/review/review.wxss */
.page {
  background: #f8f9fa;
  min-height: 100vh;
  padding-bottom: 24rpx;
}

/* 评价列表 */
.review-list {
  padding: 24rpx;
}

.review-card {
  background: #fff;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.product-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.review-rating {
  font-size: 28rpx;
  color: #ffd93d;
}

.review-content {
  margin-bottom: 16rpx;
}

.review-text {
  font-size: 26rpx;
  color: #495057;
  line-height: 1.6;
  display: block;
  margin-bottom: 12rpx;
}

.review-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.review-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
}

.review-time {
  font-size: 24rpx;
  color: #adb5bd;
}

/* 评价表单 */
.review-form {
  background: #fff;
  margin: 24rpx;
  padding: 24rpx;
  border-radius: 8rpx;
}

.form-section {
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #495057;
  margin-bottom: 12rpx;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
}

/* 评分星星 */
.rating-stars {
  display: flex;
  gap: 16rpx;
}

.star {
  font-size: 48rpx;
  color: #dee2e6;
  transition: color 0.3s;
}

.star.active {
  color: #ffd93d;
}

/* 图片上传 */
.image-upload {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.upload-btn {
  width: 160rpx;
  height: 160rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #dee2e6;
}

.upload-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
}

.upload-plus {
  font-size: 48rpx;
  color: #adb5bd;
}

/* 匿名选择 */
.checkbox-item {
  display: flex;
  align-items: center;
}

.checkbox-label {
  font-size: 28rpx;
  color: #495057;
  margin-left: 16rpx;
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.1);
}

/* 按钮样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 48rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  background: none;
  width: 100%;
}

.btn-primary {
  background: #ff6b6b;
  color: #fff;
}

.footer-btn {
  padding: 20rpx 48rpx;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #adb5bd;
  font-size: 28rpx;
}

/* 加载中 */
.loading {
  padding: 48rpx;
  text-align: center;
  color: #adb5bd;
  font-size: 28rpx;
}
