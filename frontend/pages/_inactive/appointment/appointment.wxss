/* pages/appointment/appointment.wxss */
.page {
  background: #f8f9fa;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 区域 */
.section {
  background: #fff;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
  color: #212529;
}

/* 商品选择 */
.product-select {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.select-value {
  font-size: 28rpx;
  color: #212529;
}

/* 日期选择 */
.date-scroll {
  white-space: nowrap;
  overflow-x: auto;
}

.date-item {
  display: inline-block;
  text-align: center;
  padding: 16rpx 24rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  margin-right: 16rpx;
  min-width: 120rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.date-item.active {
  background: #ff6b6b;
  color: #fff;
  border-color: #ff6b6b;
}

.date-day {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.date-month {
  font-size: 24rpx;
}

/* 时间选择 */
.time-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.time-item {
  text-align: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #212529;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.time-item.active {
  background: #ff6b6b;
  color: #fff;
  border-color: #ff6b6b;
}

/* 备注输入 */
.remark-input {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.1);
}

/* 按钮样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 48rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  background: none;
  width: 100%;
}

.btn-primary {
  background: #ff6b6b;
  color: #fff;
}

.footer-btn {
  padding: 20rpx 48rpx;
}
