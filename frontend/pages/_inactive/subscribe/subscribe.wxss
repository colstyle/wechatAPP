/* pages/subscribe/subscribe.wxss */
.page {
  background: #f8f9fa;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 区域 */
.section {
  background: #fff;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
  color: #212529;
}

/* 当前订阅 */
.subscription-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  color: #fff;
}

.subscription-card.active .subscription-header {
  justify-content: space-between;
}

.subscription-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.subscription-name {
  font-size: 32rpx;
  font-weight: bold;
}

.subscription-badge {
  background: rgba(255,255,255,255,0.3);
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.subscription-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.subscription-info {
  display: flex;
  justify-content: space-between;
}

.info-label {
  font-size: 26rpx;
  opacity: 0.9;
}

.info-value {
  font-size: 26rpx;
  font-weight: 500;
}

.info-value.highlight {
  font-size: 32rpx;
  font-weight: bold;
}

/* 套餐列表 */
.packages-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.package-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 2rpx solid #dee2e6;
  transition: all 0.3s;
}

.package-card.active {
  border-color: #ff6b6b;
  background: #fff9fa;
}

.package-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.package-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #212529;
}

.package-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.package-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.package-desc {
  font-size: 24rpx;
  color: #6c757d;
  line-height: 1.6;
}

.package-features {
  display: flex;
  gap: 24rpx;
  margin-top: 8rpx;
}

.feature {
  font-size: 24rpx;
  color: #495057;
  padding: 8rpx 16rpx;
  background: #f8f9fa;
  border-radius: 4rpx;
}

/* 底部占位 */
.bottom-placeholder {
  height: 120rpx;
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.1);
}

/* 按钮样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 48rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  background: none;
  width: 100%;
}

.btn-primary {
  background: #ff6b6b;
  color: #fff;
}

.footer-btn {
  padding: 20rpx 48rpx;
}
