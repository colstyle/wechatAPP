/* pages/product/product.wxss */
.page {
  background: #f7f7f7;
  min-height: 100vh;
}

/* 搜索框 */
.search-bar {
  padding: 20rpx;
  background: #fff;
  margin: 20rpx 20rpx 0;
  border-radius: 16rpx 16rpx 0 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.10);
}

.search-input {
  background: #f7f7f7;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 30rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  background: #fff;
  padding: 12rpx 20rpx 16rpx;
  margin: 0 20rpx 16rpx;
  border-radius: 0 0 16rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.10);
}

.filter-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #495057;
}

.filter-arrow {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #999;
}

/* 商品列表 */
.product-list {
  padding: 0 20rpx 20rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.product-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.10);
}

.product-img {
  width: 100%;
  height: 320rpx;
  display: block;
}

.product-info {
  padding: 16rpx;
}

.product-name {
  display: block;
  font-size: 30rpx;
  color: #212529;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price-row {
  display: flex;
  align-items: baseline;
}

.product-price {
  font-size: 32rpx;
  color: #ff6b6b;
  font-weight: 600;
}

.product-unit {
  font-size: 24rpx;
  color: #adb5bd;
  margin-left: 8rpx;
}

.product-stock {
  font-size: 24rpx;
  color: #adb5bd;
}

/* 空状态 */
/* 加载更多 */
.load-more {
  text-align: center;
  padding: 32rpx;
  color: #adb5bd;
  font-size: 28rpx;
}

.no-more {
  text-align: center;
  padding: 32rpx;
  color: #adb5bd;
  font-size: 24rpx;
}
