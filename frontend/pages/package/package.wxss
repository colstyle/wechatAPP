/* pages/package/package.wxss */

.page-root {
  min-height: 100vh;
  background: #FDFCF9;
  display: flex;
  flex-direction: column;
}

/* === 顶部控制台 === */
.package-header {
  background: #FFFFFF;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(28,28,28,0.04);
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
  z-index: 100;
}

.status-panel {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.status-count {
  display: flex;
  align-items: baseline;
}
.count-now {
  font-size: 48rpx;
  font-weight: bold;
  color: #1C1C1C;
}
.count-total {
  font-size: 26rpx;
  color: #B0A99A;
  margin-left: 8rpx;
}
.status-desc {
  font-size: 22rpx;
  color: #B0A99A;
  display: block;
}

.price-box {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
}
.price-sym {
  font-size: 24rpx;
  color: #C5A059;
  font-weight: bold;
}
.price-num {
  font-size: 40rpx;
  color: #C5A059;
  font-weight: bold;
}

/* 进度条 */
.progress-bar-wrap {
  width: 100%;
  height: 8rpx;
  background: #F5F4F0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}
.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #C5A059, #D4B67D);
  transition: width 0.3s ease;
}

/* 缩略图 */
.selected-thumbs-row {
  display: flex;
  gap: 20rpx;
}
.thumb-item {
  width: 96rpx; height: 96rpx;
  position: relative;
}
.thumb-img {
  width: 100%; height: 100%;
  border-radius: 12rpx;
  background: #F5F4F0;
}
.thumb-remove {
  position: absolute;
  top: -12rpx; right: -12rpx;
  width: 32rpx; height: 32rpx;
  background: #1C1C1C;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.icon-close-sm {
  width: 12rpx; height: 2rpx; background: #FFF; transform: rotate(45deg); position: relative;
}
.icon-close-sm::after {
  content: ''; position: absolute; inset: 0; background: #FFF; transform: rotate(90deg);
}

.thumb-placeholder {
  width: 96rpx; height: 96rpx;
  border: 1rpx dashed #D4CFC9;
  border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
}
.icon-plus-thin {
  width: 24rpx; height: 1rpx; background: #D4CFC9; position: relative;
}
.icon-plus-thin::after {
  content: ''; position: absolute; inset: 0; background: #D4CFC9; transform: rotate(90deg);
}

/* === 商品列表 === */
.package-scroll {
  flex: 1;
}

.grid-container {
  padding: 32rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.product-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
  transition: all 0.2s;
  border: 4rpx solid transparent;
}
.product-card.is-selected {
  border-color: #C5A059;
}

.card-cover-wrap {
  position: relative;
  width: 100%;
  padding-bottom: 110%;
}
.card-img {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
}

.selection-overlay {
  position: absolute; inset: 0;
  background: rgba(197, 160, 89, 0.1);
  display: flex; align-items: center; justify-content: center;
}
.icon-check-circle {
  width: 48rpx; height: 48rpx;
  background: #C5A059;
  border-radius: 50%;
  position: relative;
}
.icon-check-circle::after {
  content: ''; position: absolute;
  width: 18rpx; height: 10rpx;
  border-left: 3rpx solid #FFF;
  border-bottom: 3rpx solid #FFF;
  transform: rotate(-45deg);
  top: 14rpx; left: 14rpx;
}

.card-info {
  padding: 16rpx;
}
.prod-name {
  font-size: 26rpx;
  color: #1C1C1C;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
  height: 36rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.prod-meta {
  display: flex; align-items: baseline;
  font-size: 22rpx;
}
.meta-label { color: #B0A99A; margin-right: 6rpx; }
.meta-val { color: #C5A059; font-weight: bold; }

/* === 底部栏 === */
.bottom-bar {
  background: #FFFFFF;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.shadow-top {
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.04);
}

.total-detail {
  display: flex;
  flex-direction: column;
}
.price-row {
  display: flex;
  align-items: baseline;
}
.total-label { font-size: 24rpx; color: #1C1C1C; margin-right: 12rpx; }
.total-sym { font-size: 24rpx; color: #1C1C1C; font-weight: bold; }
.total-val { font-size: 40rpx; color: #1C1C1C; font-weight: bold; }
.total-hint { font-size: 20rpx; color: #B0A99A; margin-top: 4rpx; }

.submit-btn {
  background: #F5F4F0;
  color: #B0A99A;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  border: none;
  margin: 0;
}
.btn-active {
  background: #1C1C1C;
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(28,28,28,0.2);
}

/* 清理 no-more 样式 */
.no-more { text-align: center; font-size: 22rpx; color: #B0A99A; padding: 40rpx 0; }

.loading-dots { display: flex; justify-content: center; gap: 8rpx; padding: 40rpx 0; }
.dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #C5A059; animation: dotBounce 1.2s infinite ease-in-out both; }
.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }
@keyframes dotBounce { 0%,80%,100% { transform: scale(0.6); opacity: 0.4; } 40% { transform: scale(1); opacity: 1; } }
