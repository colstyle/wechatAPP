.package-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f7f7;
  padding-bottom: 160rpx;
}

.package-top {
  padding-bottom: 0;
}

.package-scroll {
  flex: 1;
}

.progress-track {
  margin-top: 16rpx;
  height: 10rpx;
  background: #eeeeee;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #ff6b6b;
  border-radius: 999rpx;
}

.selected-items {
  display: flex;
  gap: 12rpx;
}

.selected-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #f7f7f7;
  border: 1rpx solid #eeeeee;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.selected-emoji {
  font-size: 44rpx;
}

.selected-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.6);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.package-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.10);
  border: 2rpx solid transparent;
}

.package-card.selected {
  border-color: #ff6b6b;
}

.package-cover {
  height: 320rpx;
  background: #f7f7f7;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.package-emoji {
  font-size: 96rpx;
}

.package-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ff6b6b;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
}

.package-info {
  padding: 16rpx;
}

.package-name {
  font-size: 30rpx;
  color: #212529;
  font-weight: 500;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.package-meta {
  font-size: 24rpx;
  color: #666;
}

.package-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.total-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.total-label {
  font-size: 24rpx;
  color: #666;
}

.total-price {
  font-size: 40rpx;
  color: #ff6b6b;
  font-weight: 600;
}

.total-desc {
  font-size: 22rpx;
  color: #999;
}

.package-submit[disabled] {
  opacity: 0.3;
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
  color: #999;
  font-size: 26rpx;
}
