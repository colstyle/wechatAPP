/* pages/pay/pay.wxss */
.page {
  background: #f8f9fa;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 订单信息 */
.order-info {
  background: #fff;
  margin: 24rpx;
  padding: 24rpx;
  border-radius: 8rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #dee2e6;
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #6c757d;
}

.value {
  font-size: 28rpx;
  color: #212529;
}

.value.price {
  color: #ff6348;
  font-weight: 500;
}

/* 支付方式 */
.payment-section {
  background: #fff;
  margin: 24rpx;
  padding: 24rpx;
  border-radius: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
  color: #212529;
}

.payment-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.payment-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.payment-item.active {
  background: #fff;
  border-color: #ff6b6b;
}

.payment-icon {
  font-size: 28rpx;
  color: #212529;
}

.check-icon {
  color: #ff6b6b;
  font-size: 32rpx;
  font-weight: bold;
}

/* 底部支付栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.1);
}

.footer-left {
  display: flex;
  flex-direction: column;
}

.total-label {
  font-size: 24rpx;
  color: #6c757d;
}

.total-price {
  font-size: 40rpx;
  color: #ff6348;
  font-weight: bold;
}

/* 按钮样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 48rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  background: none;
}

.btn-primary {
  background: #ff6b6b;
  color: #fff;
}

.footer-btn {
  padding: 20rpx 48rpx;
}
