/* pages/pay/pay.wxss */

.page-root {
  height: 100vh;
  background: #FDFCF9;
  display: flex;
  flex-direction: column;
}

.content {
  flex: 1;
  padding: 40rpx 24rpx;
}

/* 金额高亮区 */
.amt-box {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 60rpx 0; margin-bottom: 20rpx;
}
.amt-lbl { font-size: 26rpx; color: #8E877F; margin-bottom: 24rpx; }
.amt-val { display: flex; align-items: baseline; gap: 8rpx; }
.sym { font-size: 40rpx; color: #1C1C1C; font-weight: 500; }
.num { font-size: 72rpx; color: #1C1C1C; font-weight: 600; font-family: 'Helvetica Neue', sans-serif;}

/* 卡片 */
.card {
  background: #FFFFFF; border-radius: 24rpx; padding: 32rpx 28rpx; margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(28,28,28,0.03);
}

/* 行数据 */
.row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.row:last-child { margin-bottom: 0; }
.row-left { font-size: 28rpx; color: #8E877F; }
.row-right { font-size: 28rpx; color: #1C1C1C; font-weight: 500; font-family: 'Helvetica Neue', sans-serif; }

/* 支付方式 */
.sec-title { font-size: 28rpx; font-weight: 600; color: #1C1C1C; margin-bottom: 32rpx; }
.method-item {
  display: flex; justify-content: space-between; align-items: center; padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(28,28,28,0.04);
}
.method-item:last-child { border-bottom: none; padding-bottom: 0;}
.m-left { display: flex; align-items: center; gap: 20rpx; }
.m-name { font-size: 28rpx; color: #1C1C1C; }

/* 纯CSS 微信小气泡 */
.icon-wx { width: 44rpx; height: 44rpx; background: #07C160; border-radius: 50%; position: relative; border: 4rpx solid rgba(7,193,96,0.2); background-clip: padding-box;}
.wx-bubble1 { width: 14rpx; height: 10rpx; background: #FFF; border-radius: 6rpx; position: absolute; top: 12rpx; left: 10rpx;}
.wx-bubble2 { width: 10rpx; height: 8rpx; background: #FFF; border-radius: 4rpx; position: absolute; bottom: 12rpx; right: 10rpx;}
.tag-rec { font-size: 20rpx; color: #FFFFFF; background: #FF4D4F; padding: 2rpx 10rpx; border-radius: 6rpx; margin-left: 12rpx;}

/* 支付宝简易图标 */
.icon-zfb { width: 44rpx; height: 44rpx; background: #1677FF; border-radius: 50%; color: #FFF; font-size:24rpx; display:flex; align-items:center; justify-content:center; border: 4rpx solid rgba(22,119,255,0.2); background-clip: padding-box; }

/* 单选框 */
.radio-circle { width: 40rpx; height: 40rpx; border-radius: 50%; border: 3rpx solid #D4CFC9; position: relative; transition: all 0.2s; box-sizing: border-box;}
.active .radio-circle { border-color: #C5A059; }
.active .radio-circle::after { content: ''; position: absolute; inset: 8rpx; background: #C5A059; border-radius: 50%; }

/* 底部操作 */
.footer-safe {
  padding: 24rpx 40rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(253, 252, 249, 0.95); backdrop-filter: blur(20px); border-top: 1rpx solid rgba(28,28,28,0.06);
}
.btn-pay {
  height: 96rpx; border-radius: 48rpx; background: #07C160; color: #FFF; font-size: 30rpx; font-weight: 500;
  display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(7,193,96,0.2);
  border: none;
}
.btn-pay[disabled] { background: #D4CFC9; box-shadow: none; color: #FFFFFF; }
