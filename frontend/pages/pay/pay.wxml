<!-- pages/pay/pay.wxml -->
<view class="page-root">
  <cp-nav-bar title="支付收银台" show-back="{{true}}" bg="white"></cp-nav-bar>

  <view class="content">
    
    <!-- 支付金额高亮 -->
    <view class="amt-box">
      <text class="amt-lbl">需支付</text>
      <view class="amt-val">
        <text class="sym">¥</text>
        <text class="num">{{order.total_amount || '0.00'}}</text>
      </view>
    </view>

    <!-- 订单信息卡片 -->
    <view class="card">
      <view class="row">
        <text class="row-left">订单号</text>
        <text class="row-right">{{order.order_no || '加载中...'}}</text>
      </view>
      <view class="row">
        <text class="row-left">租赁模式</text>
        <text class="row-right">{{order.rentalTypeText || '--'}}</text>
      </view>
    </view>

    <!-- 支付方式选择 -->
    <view class="card pay-methods">
      <view class="sec-title">选择支付方式</view>
      
      <view class="method-item {{selectedPayment === 'wechat' ? 'active' : ''}}" bindtap="onPaymentTap" data-type="wechat">
        <view class="m-left">
          <view class="icon-wx">
            <view class="wx-bubble1"></view>
            <view class="wx-bubble2"></view>
          </view>
          <text class="m-name">微信支付</text>
          <text class="tag-rec">推荐</text>
        </view>
        <view class="m-right">
          <view class="radio-circle"></view>
        </view>
      </view>

      <!-- 演示占位的其它支付方式 -->
      <view class="method-item {{selectedPayment === 'alipay' ? 'active' : ''}}" bindtap="onPaymentTap" data-type="alipay">
        <view class="m-left">
          <view class="icon-zfb">支</view>
          <text class="m-name">支付宝支付</text>
        </view>
        <view class="m-right">
          <view class="radio-circle"></view>
        </view>
      </view>
    </view>

  </view>

  <!-- 底部支付按钮 -->
  <view class="footer-safe">
    <button class="btn-pay" bindtap="onPay" disabled="{{!selectedPayment || !order}}">
      确认支付 ¥{{order.total_amount || '0.00'}}
    </button>
  </view>
</view>
