<!--pages/pay/pay.wxml-->
<view class="page">
  <!-- 订单信息 -->
  <view class="order-info" wx:if="{{order}}">
    <view class="info-row">
      <text class="label">订单号:</text>
      <text class="value">{{order.order_no}}</text>
    </view>
    <view class="info-row">
      <text class="label">租赁类型:</text>
      <text class="value">{{order.rentalTypeText}}</text>
    </view>
    <view class="info-row" wx:if="{{order.rent_days > 0}}">
      <text class="label">租赁天数:</text>
      <text class="value">{{order.rent_days}}天</text>
    </view>
    <view class="info-row">
      <text class="label">订单金额:</text>
      <text class="value price">¥{{order.total_amount}}</text>
    </view>
  </view>

  <!-- 支付方式 -->
  <view class="payment-section">
    <view class="section-title">选择支付方式</view>
    <view class="payment-list">
      <view
        class="payment-item {{selectedPayment === 'wechat' ? 'active' : ''}}"
        bindtap="onPaymentTap"
        data-type="wechat">
        <text class="payment-icon wechat">微信支付</text>
        <text class="check-icon" wx:if="{{selectedPayment === 'wechat'}}">✓</text>
      </view>
    </view>
  </view>

  <!-- 底部支付栏 -->
  <view class="footer">
    <view class="footer-left">
      <text class="total-label">应付金额</text>
      <text class="total-price">¥{{order.total_amount || 0}}</text>
    </view>
    <button class="btn btn-primary footer-btn" bindtap="onPay" disabled="{{!selectedPayment}}">
      立即支付
    </button>
  </view>
</view>
