<!-- pages/order/order.wxml -->
<view class="page-root">
  <!-- 沉浸式背景 -->
  <view class="hero-bg">
    <image class="hero-img" src="{{imgBase}}/order_center_banner.png" mode="aspectFill"></image>
    <view class="hero-mask"></view>
  </view>

  <!-- 自定义导航 -->
  <cp-nav-bar title="" show-back="{{false}}" bg="transparent" border="{{false}}"></cp-nav-bar>

  <view class="order-center-body">
    
    <!-- 状态磁贴区域 -->
    <view class="status-glass-card">
      <view class="sg-header">当前订单状态</view>
      <view class="sg-grid">
        <view class="sg-item" bindtap="onOrdersTap" data-status="1">
          <view class="sg-icon-box bg-blue">
            <view class="icon-hanger-m"></view>
          </view>
          <text class="sg-label">待取衣</text>
          <view class="sg-dot" wx:if="{{orderStats.pendingPickup > 0}}">{{orderStats.pendingPickup}}</view>
        </view>

        <view class="sg-item" bindtap="onOrdersTap" data-status="2">
          <view class="sg-icon-box bg-gold">
            <view class="icon-clock-m"></view>
          </view>
          <text class="sg-label">租赁中</text>
          <view class="sg-dot" wx:if="{{orderStats.renting > 0}}">{{orderStats.renting}}</view>
        </view>

        <view class="sg-item" bindtap="onOrdersTap" data-status="3">
          <view class="sg-icon-box bg-sage">
            <view class="icon-return-m"></view>
          </view>
          <text class="sg-label">待归还</text>
        </view>

        <view class="sg-item" bindtap="onOrdersTap" data-status="">
          <view class="sg-icon-box bg-neutral">
            <view class="icon-all-m"></view>
          </view>
          <text class="sg-label">全部</text>
        </view>
      </view>
    </view>

    <!-- 悦己服务入口 -->
    <view class="service-group">
      <view class="group-title">专属悦己服务</view>
      
      <view class="service-row" bindtap="onRentTap">
        <view class="sr-icon bg-gold-lite">
          <view class="icon-shirt-m"></view>
        </view>
        <view class="sr-info">
          <text class="sr-name">即刻选款</text>
          <text class="sr-desc">挑选本季最热单品</text>
        </view>
        <view class="sr-chevron"></view>
      </view>

      <view class="service-row" bindtap="onAppointmentTap">
        <view class="sr-icon bg-blue-lite">
          <view class="icon-calendar-m"></view>
        </view>
        <view class="sr-info">
          <text class="sr-name">到店试穿</text>
          <text class="sr-desc">预约专属搭配顾问</text>
        </view>
        <view class="sr-chevron"></view>
      </view>

      <view class="service-row" bindtap="onSubscribeTap">
        <view class="sr-icon bg-pearl-lite">
          <view class="icon-crown-m"></view>
        </view>
        <view class="sr-info">
          <text class="sr-name">会员订阅</text>
          <text class="sr-desc">无限穿搭自由计划</text>
        </view>
        <view class="sr-chevron"></view>
      </view>
    </view>

    <view class="order-footer-note">— 小时光 • 悦见更美的自己 —</view>
  </view>
</view>
