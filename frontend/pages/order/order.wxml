<!--pages/order/order.wxml-->
<view class="page">
  <!-- 当前订单统计 -->
  <view class="stats-section">
    <view class="section-title">当前订单</view>
    <view class="stats-grid">
      <view class="stat-item" bindtap="onOrdersTap" data-status="2">
        <text class="stat-icon">📦</text>
        <text class="stat-label">租赁中</text>
        <text class="stat-badge">{{orderStats.renting || 0}}</text>
      </view>
      <view class="stat-item" bindtap="onOrdersTap" data-status="3">
        <text class="stat-icon">🔄</text>
        <text class="stat-label">待归还</text>
        <text class="stat-badge">{{orderStats.returning || 0}}</text>
      </view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="function-section">
    <view class="function-item" bindtap="onRentTap">
      <text class="function-icon">🎯</text>
      <text class="function-text">我要租衣服</text>
      <text class="iconfont icon-arrow-right"></text>
    </view>
    <view class="function-item" bindtap="onAppointmentTap">
      <text class="function-icon">📅</text>
      <text class="function-text">预约试穿</text>
      <text class="iconfont icon-arrow-right"></text>
    </view>
    <view class="function-item" bindtap="onSubscribeTap">
      <text class="function-icon">💎</text>
      <text class="function-text">会员订阅</text>
      <text class="iconfont icon-arrow-right"></text>
    </view>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-placeholder"></view>
</view>
