.page {
  padding: 20rpx;
  background: #f7f7f7;
  min-height: 100vh;
}

.section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.label {
  color: #666;
}

.value {
  color: #333;
}

.item-img {
  width: 180rpx;
  height: 240rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
}

.order-item {
  display: flex;
  margin-bottom: 20rpx;
}

.item-meta {
  flex: 1;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.item-spec,
.item-price {
  color: #999;
  margin-bottom: 8rpx;
}

.bottom-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.status {
  color: #ff6b6b;
}

.countdown {
  color: #ff6b6b;
  font-weight: bold;
  font-size: 32rpx;
}

.loading {
  text-align: center;
  color: #999;
  margin-top: 20rpx;
}
