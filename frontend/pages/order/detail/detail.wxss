.page {
  padding: 20rpx;
}

.section {
  background: #fff;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.label {
  color: #666;
}

.value {
  color: #333;
}

.item-img {
  width: 180rpx;
  height: 240rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.order-item {
  display: flex;
  margin-bottom: 20rpx;
}

.item-meta {
  flex: 1;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.item-spec,
.item-price {
  color: #999;
  margin-bottom: 8rpx;
}

.bottom-actions {
  display: flex;
  justify-content: space-between;
}

.btn {
  flex: 1;
  margin-right: 20rpx;
}

.btn:last-child {
  margin-right: 0;
}

.btn-primary {
  background-color: #ff6b6b;
  color: #fff;
}

.btn-danger {
  background-color: #ff4d4f;
  color: #fff;
}

.status {
  color: #ff6b6b;
}

.loading {
  text-align: center;
  color: #999;
  margin-top: 20rpx;
}