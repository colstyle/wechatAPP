/* pages/order/detail/detail.wxss */

.page-root {
  min-height: 100vh;
  background: #FDFCF9;
  display: flex;
  flex-direction: column;
}

.page-scroll { flex: 1; }
.content-pad { padding: 24rpx 32rpx 180rpx; }

.shadow-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(28, 28, 28, 0.04);
  margin-bottom: 24rpx;
  overflow: hidden;
}

/* === 状态头卡片 === */
.status-header-card {
  background: #1C1C1C;
  padding: 48rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sh-status-text {
  font-size: 40rpx; font-weight: bold; color: #FFF; display: block; margin-bottom: 8rpx;
}
.sh-sub-text { font-size: 24rpx; color: rgba(255,255,255,0.6); }

.sh-icon-box {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.bg-gold { background: rgba(197, 160, 89, 0.2); border: 1rpx solid rgba(197, 160, 89, 0.3); }

/* 详情卡片内容 */
.detail-card { padding: 32rpx; }
.card-header { display: flex; align-items: center; margin-bottom: 32rpx; }
.card-title { font-size: 30rpx; font-weight: 600; color: #1C1C1C; }
.card-tag { font-size: 20rpx; background: rgba(197, 160, 89, 0.1); color: #C5A059; padding: 4rpx 16rpx; border-radius: 4rpx; font-weight: 600; }

.info-group { display: flex; flex-direction: column; gap: 24rpx; }
.info-row { display: flex; justify-content: space-between; align-items: center; }
.label { font-size: 26rpx; color: #B0A99A; }
.value { font-size: 26rpx; color: #1C1C1C; text-align: right; }
.code-text { font-family: monospace; font-size: 32rpx; color: #C5A059; font-weight: bold; letter-spacing: 2rpx; }
.total-highlight { margin-top: 12rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(28,28,28,0.04); }
.value-bold { font-size: 36rpx; font-weight: bold; color: #C5A059; }

/* 商品列表项 */
.product-item { display: flex; align-items: center; margin-bottom: 24rpx; }
.product-item:last-child { margin-bottom: 0; }
.p-img { width: 120rpx; height: 160rpx; border-radius: 12rpx; background: #EEECE8; margin-right: 24rpx; }
.p-info { flex: 1; display: flex; flex-direction: column; }
.p-name { font-size: 28rpx; color: #1C1C1C; font-weight: 500; margin-bottom: 4rpx; }
.p-spec { font-size: 22rpx; color: #B0A99A; margin-bottom: 12rpx; }
.p-price-row { display: flex; justify-content: space-between; align-items: center; }
.p-price { font-size: 26rpx; color: #C5A059; font-weight: 600; }
.p-qty { font-size: 24rpx; color: #B0A99A; }

/* 底部悬浮杠 */
.action-bar-wrap {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(20px);
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex; gap: 24rpx; border-top: 1rpx solid rgba(28,28,28,0.03);
  z-index: 100;
}
.action-btn {
  flex: 1; height: 88rpx; border-radius: 44rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600;
}
.btn-primary { background: #C5A059; color: #FFF; }
.btn-outline { border: 2rpx solid #D4CFC9; color: #8E877F; }

/* 全屏加载 */
.full-loading { position: fixed; inset: 0; background: #FDFCF9; display: flex; align-items: center; justify-content: center; z-index: 1000; }
.loading-spinner { width: 64rpx; height: 64rpx; border: 4rpx solid #EEE; border-top-color: #C5A059; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
