/* pages/order/order.wxss */
.page {
  background: #f8f9fa;
  min-height: 100vh;
}

/* 统计区域 */
.stats-section {
  background: #fff;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
  color: #212529;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
  background: #f8f9fa;
  border-radius: 8rpx;
  position: relative;
}

.stat-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.stat-label {
  font-size: 28rpx;
  color: #495057;
}

.stat-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: #ff6348;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  min-width: 32rpx;
  text-align: center;
}

/* 功能入口 */
.function-section {
  background: #fff;
  padding: 0 24rpx;
}

.function-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #dee2e6;
}

.function-item:last-child {
  border-bottom: none;
}

.function-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.function-text {
  flex: 1;
  font-size: 28rpx;
  color: #495057;
}

.function-item .icon-arrow-right {
  color: #adb5bd;
  font-size: 24rpx;
}

/* 底部占位 */
.bottom-placeholder {
  height: 120rpx;
}
