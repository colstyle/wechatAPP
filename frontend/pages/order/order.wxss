/* pages/order/order.wxss */

.page-root {
  min-height: 100vh;
  background: #F8F7F5;
  position: relative;
}

/* === 顶部英雄区 === */
.hero-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 500rpx;
  z-index: 0;
}
.hero-img { width: 100%; height: 100%; }
.hero-mask {
  position: absolute; inset: 0;
  background: linear-gradient(to bottom, rgba(248, 247, 245, 0) 0%, rgba(248, 247, 245, 1) 90%);
}

.order-center-body {
  position: relative;
  z-index: 1;
  padding: 300rpx 32rpx 60rpx;
}

/* === 状态磁贴 === */
.status-glass-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(28, 28, 28, 0.05);
}

.sg-header {
  font-size: 26rpx; font-weight: 600; color: #1C1C1C;
  margin-bottom: 32rpx; padding-left: 12rpx;
  border-left: 4rpx solid #C5A059;
}

.sg-grid { display: flex; justify-content: space-around; }
.sg-item {
  display: flex; flex-direction: column; align-items: center; position: relative;
}

.sg-icon-box {
  width: 96rpx; height: 96rpx; border-radius: 28rpx;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 16rpx;
}
.bg-blue { background: rgba(122, 143, 166, 0.08); }
.bg-gold { background: rgba(197, 160, 89, 0.08); }
.bg-sage { background: rgba(142, 151, 117, 0.08); }
.bg-neutral { background: rgba(28, 28, 28, 0.04); }

.sg-label { font-size: 24rpx; color: #1C1C1C; font-weight: 500; }
.sg-dot {
  position: absolute; top: -6rpx; right: -6rpx;
  background: #C5A059; color: #FFF; font-size: 18rpx; font-weight: bold;
  min-width: 32rpx; height: 32rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  border: 4rpx solid #FFF;
}

/* 状态图标 */
.icon-hanger-m { width: 36rpx; height: 32rpx; border: 2rpx solid #7A8FA6; border-top: none; position: relative; }
.icon-hanger-m::after { content: ''; position: absolute; top: -10rpx; left: 50%; transform: translateX(-50%); width: 36rpx; border-top: 2rpx solid #7A8FA6; }

.icon-clock-m { width: 34rpx; height: 34rpx; border: 2rpx solid #C5A059; border-radius: 50%; position: relative; }
.icon-clock-m::after { content: ''; position: absolute; top: 6rpx; left: 50%; width: 2rpx; height: 12rpx; background: #C5A059; }

.icon-return-m { width: 32rpx; height: 32rpx; border: 2rpx solid #8E9775; border-radius: 50%; border-right-color: transparent; transform: rotate(45deg); position: relative; }
.icon-return-m::after { content: ''; position: absolute; top: -4rpx; right: -4rpx; border: 6rpx solid transparent; border-top-color: #8E9775; }

.icon-all-m { width: 30rpx; height: 26rpx; border: 2rpx solid #B0A99A; position: relative; }
.icon-all-m::after { content: ''; position: absolute; top: 8rpx; left: 4rpx; right: 4rpx; height: 2rpx; background: #B0A99A; box-shadow: 0 6rpx 0 #B0A99A; }

/* === 服务列表 === */
.service-group {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(28,28,28,0.03);
  margin-bottom: 40rpx;
}
.group-title { font-size: 26rpx; font-weight: 600; color: #1C1C1C; padding: 32rpx 0 16rpx; }

.service-row {
  display: flex; align-items: center; padding: 32rpx 0;
  border-bottom: 1rpx solid rgba(28,28,28,0.03);
}
.service-row:last-child { border-bottom: none; }

.sr-icon {
  width: 80rpx; height: 80rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  margin-right: 24rpx;
}
.bg-gold-lite { background: rgba(197, 160, 89, 0.08); }
.bg-blue-lite { background: rgba(122, 143, 166, 0.08); }
.bg-pearl-lite { background: rgba(142, 151, 117, 0.08); }

.sr-info { flex: 1; display: flex; flex-direction: column; }
.sr-name { font-size: 28rpx; color: #1C1C1C; font-weight: 500; margin-bottom: 4rpx; }
.sr-desc { font-size: 22rpx; color: #B0A99A; }

.sr-chevron {
  width: 12rpx; height: 12rpx; border-right: 2rpx solid #CECAC4; border-bottom: 2rpx solid #CECAC4;
  transform: rotate(-45deg);
}

/* 列表图标 */
.icon-shirt-m { width: 32rpx; height: 28rpx; background: #C5A059; border-radius: 4rpx; }
.icon-calendar-m { width: 30rpx; height: 30rpx; border: 2rpx solid #7A8FA6; }
.icon-crown-m { width: 34rpx; height: 24rpx; border: 2rpx solid #8E9775; border-top: none; }

.order-footer-note { text-align: center; font-size: 22rpx; color: #CECAC4; margin-top: 40rpx; }
