<!-- pages/category/category.wxml -->
<view class="page-root">
  <cp-nav-bar title="选款分类" show-back="{{false}}" bg="white"></cp-nav-bar>

  <view wx:if="{{categories.length === 0}}" style="padding: 40rpx 24rpx;">
    <cp-empty text="暂无分类" subText="店主还未添加任何分类数据"></cp-empty>
  </view>

  <view wx:else style="display: flex; flex-direction: column; flex: 1; overflow: hidden;">
    <!-- 搜索栏 -->
    <view class="search-wrap">
      <view class="search-bar">
        <view class="icon-search">
          <view class="search-circle"></view>
          <view class="search-handle"></view>
        </view>
        <input
          class="search-input"
          placeholder="搜索商品名称..."
          placeholder-class="search-ph"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
          confirm-type="search"
          value="{{keyword}}"
        />
        <view class="clear-btn" wx:if="{{keyword}}" bindtap="clearSearch">
          <view class="clear-icon"></view>
        </view>
      </view>
    </view>

    <view class="content-body">
      <!-- 左侧分类栏 -->
      <scroll-view class="sidebar" scroll-y>
        <view
          class="sidebar-item {{activeCategoryId === item.id ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="id"
          bindtap="onGroupTap"
          data-id="{{item.id}}"
        >
          <view class="active-bar" wx:if="{{activeCategoryId === item.id}}"></view>
          <text class="sidebar-name">{{item.name}}</text>
        </view>
      </scroll-view>

      <!-- 右侧主内容区（商品列表） -->
      <scroll-view class="main-content" scroll-y>
        <!-- 搜索模式提示 -->
        <view wx:if="{{isSearching}}" class="search-result-tip">
          <text>找到 {{products.length}} 件商品</text>
        </view>

        <!-- 空状态 -->
        <view class="empty-state" wx:if="{{products.length === 0}}">
          <text class="empty-emoji">👗</text>
          <text class="empty-text">这里还没有商品哦</text>
        </view>

        <!-- 商品网格 -->
        <view class="product-grid" wx:else>
          <view
            class="product-card"
            wx:for="{{products}}"
            wx:key="id"
            bindtap="onProductTap"
            data-id="{{item.id}}"
          >
            <image class="product-img" src="{{item.main_image}}" mode="aspectFill"></image>
            <view class="product-info">
              <text class="product-name">{{item.name}}</text>
              <view class="product-price-row">
                <text class="price-symbol">¥</text>
                <text class="price-val">{{item.price}}</text>
                <text class="price-unit">/天</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
