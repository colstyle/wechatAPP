<!--pages/category/category.wxml-->
<view class="page">
  <!-- 搜索框 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索商品" bindconfirm="onSearchConfirm" confirm-type="search" value="{{keyword}}"/>
  </view>

  <!-- 分类列表 -->
  <view class="category-container">
    <!-- 一级分类 -->
    <view class="category-sidebar">
      <view
        class="category-item {{selectedCategory === item.id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        bindtap="onCategoryTap"
        data-id="{{item.id}}">
        {{item.name}}
      </view>
    </view>

    <!-- 二级分类/商品 -->
    <view class="category-content">
      <!-- 子分类 -->
      <view class="sub-category-list" wx:if="{{selectedCategory && subCategories.length > 0}}">
        <view
          class="sub-category-item"
          wx:for="{{subCategories}}"
          wx:key="id"
          bindtap="onSubCategoryTap"
          data-id="{{item.id}}">
          <image class="sub-category-icon" src="{{item.icon}}" mode="aspectFill"></image>
          <text class="sub-category-name">{{item.name}}</text>
        </view>
      </view>

      <!-- 商品列表 -->
      <view class="product-list" wx:if="{{products.length > 0}}">
        <view
          class="product-card"
          wx:for="{{products}}"
          wx:key="id"
          bindtap="onProductTap"
          data-id="{{item.id}}">
          <image class="product-img" src="{{item.cover_image}}" mode="aspectFill"></image>
          <view class="product-info">
            <text class="product-name">{{item.name}}</text>
            <view class="product-price-row">
              <text class="product-price">¥{{item.daily_rent}}</text>
              <text class="product-unit">/天</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty" wx:if="{{products.length === 0 && !loading}}">
        <text>暂无商品</text>
      </view>

      <!-- 加载中 -->
      <view class="loading" wx:if="{{loading}}">
        <text>加载中...</text>
      </view>
    </view>
  </view>
</view>
