/* pages/category/category.wxss */

.page-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FDFCF9;
  overflow: hidden;
}

/* ===== 搜索栏 ===== */
.search-wrap {
  padding: 16rpx 24rpx 12rpx;
  background: #FDFCF9;
  z-index: 10;
}
.search-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  height: 80rpx;
  border-radius: 40rpx;
  padding: 0 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(28,28,28,0.05);
  border: 1.5rpx solid rgba(28,28,28,0.06);
}

/* 搜索图标 纯CSS */
.icon-search {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.search-circle {
  width: 22rpx;
  height: 22rpx;
  border: 2.5rpx solid #B0A99A;
  border-radius: 50%;
  position: absolute;
  top: 0; left: 0;
}
.search-handle {
  width: 2.5rpx;
  height: 10rpx;
  background: #B0A99A;
  position: absolute;
  bottom: -2rpx; right: 2rpx;
  transform: rotate(-45deg);
  border-radius: 2rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1C1C1C;
}
.search-ph { color: #C0BBB4; }

/* 清除按钮 */
.clear-btn {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.clear-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #D4CFC9;
  position: relative;
}
.clear-icon::before,
.clear-icon::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 2rpx;
  background: #FFF;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(45deg);
}
.clear-icon::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* ===== 主体布局 ===== */
.content-body {
  flex: 1;
  display: flex;
  overflow: hidden;
  margin-top: 4rpx;
}

/* ===== 左侧分类栏 ===== */
.sidebar {
  width: 180rpx;
  height: 100%;
  background: rgba(238, 236, 232, 0.4);
  flex-shrink: 0;
}
.sidebar-item {
  position: relative;
  min-height: 100rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s, font-weight 0.2s;
}
.sidebar-item.active {
  background: #FDFCF9;
}
.active-bar {
  position: absolute;
  left: 0;
  top: 30rpx;
  bottom: 30rpx;
  width: 6rpx;
  background: #C5A059;
  border-radius: 0 6rpx 6rpx 0;
}
.sidebar-name {
  font-size: 26rpx;
  color: #8E877F;
  text-align: center;
  line-height: 1.4;
}
.sidebar-item.active .sidebar-name {
  color: #1C1C1C;
  font-weight: 700;
  font-size: 28rpx;
}

/* ===== 右侧商品区 ===== */
.main-content {
  flex: 1;
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

/* ===== 搜索提示 ===== */
.search-result-tip {
  padding: 20rpx 24rpx 10rpx;
  font-size: 24rpx;
  color: #B0A99A;
}

/* ===== 商品网格 ===== */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 24rpx;
}

.product-card {
  background: #FFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(28,28,28,0.04);
  border: 1px solid rgba(28,28,28,0.03);
  display: flex;
  flex-direction: column;
}

.product-img {
  width: 100%;
  height: 260rpx;
  background: #F8F6F2;
}

.product-info {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 26rpx;
  color: #1C1C1C;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  color: #C5A059;
  margin-top: auto;
}

.price-symbol {
  font-size: 20rpx;
  font-weight: 700;
}

.price-val {
  font-size: 32rpx;
  font-weight: 700;
  margin: 0 4rpx;
  letter-spacing: -0.5px;
}

.price-unit {
  font-size: 20rpx;
  color: #8E877F;
  margin-left: 2rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  gap: 16rpx;
}
.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 8rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #1C1C1C;
  font-weight: 500;
}
