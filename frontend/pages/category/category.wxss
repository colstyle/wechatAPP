/* pages/category/category.wxss */

.page-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FDFCF9;
  overflow: hidden;
}

/* === 搜索区 === */
.search-wrap {
  padding: 16rpx 24rpx;
  background: #FDFCF9;
  z-index: 10;
}
.search-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  height: 80rpx;
  border-radius: 40rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(28,28,28,0.04);
  border: 1.5rpx solid rgba(28,28,28,0.05);
}

/* 放大镜纯CSS */
.icon-search {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin-right: 16rpx;
}
.search-circle {
  width: 22rpx;
  height: 22rpx;
  border: 2.5rpx solid #B0A99A;
  border-radius: 50%;
  position: absolute;
  top: 0; left: 0;
}
.search-handle {
  width: 2.5rpx;
  height: 10rpx;
  background: #B0A99A;
  position: absolute;
  bottom: -2rpx; right: 2rpx;
  transform: rotate(-45deg);
  border-radius: 2rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1C1C1C;
}
.search-ph { color: #C0BBB4; }

/* === 主体内容区 === */
.content-body {
  flex: 1;
  display: flex;
  overflow: hidden;
  margin-top: 8rpx;
}

/* === 左侧栏 === */
.sidebar {
  width: 180rpx;
  height: 100%;
  background: rgba(238, 236, 232, 0.4);
}
.sidebar-item {
  position: relative;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #8E877F;
  transition: all 0.2s;
}
.sidebar-item.active {
  background: #FDFCF9;
  color: #1C1C1C;
  font-weight: 600;
}
.active-indicator {
  position: absolute;
  left: 0; top: 30rpx; bottom: 30rpx;
  width: 6rpx;
  background: #C5A059;
  border-radius: 0 4rpx 4rpx 0;
}
.sidebar-text { position: relative; z-index: 2; }

/* === 右侧主内容 === */
.main-content {
  flex: 1;
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 子分类 */
.sub-cats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.sub-cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(28,28,28,0.03);
}
.sub-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  background: #F5F4F0;
}
.sub-name {
  font-size: 24rpx;
  color: #1C1C1C;
}

/* 商品网格 */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

/* === 空状态 === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}
.icon-empty-box {
  width: 80rpx;
  height: 60rpx;
  position: relative;
  margin-bottom: 24rpx;
}
.box-body {
  position: absolute;
  bottom: 0; left: 10rpx; right: 10rpx;
  height: 48rpx;
  border: 2.5rpx solid #D4CFC9;
  border-radius: 4rpx;
}
.box-lid {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 12rpx;
  border: 2.5rpx solid #D4CFC9;
  border-radius: 3rpx;
  background: #FDFCF9;
  z-index: 2;
}

.empty-text { font-size: 28rpx; color: #1C1C1C; margin-bottom: 8rpx; font-weight: 500;}
.empty-sub { font-size: 24rpx; color: #B0A99A; }

/* === 加载态 === */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}
.loading-dots { display: flex; gap: 8rpx; }
.dot {
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  background: #C5A059;
  animation: dotBounce 1.2s infinite ease-in-out both;
}
.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }
@keyframes dotBounce {
  0%,80%,100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}
