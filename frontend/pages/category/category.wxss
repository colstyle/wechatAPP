/* pages/category/category.wxss */

.page-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FDFCF9;
  overflow: hidden;
}

/* ===== 店主管理功能栏（Premium Card Style） ===== */
.admin-toolbar {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  background: linear-gradient(180deg, #FDF9F2 0%, #FDFCF9 100%);
  border-bottom: 1.5rpx solid rgba(197,160,89,0.12);
}

/* 每张管理卡片 */
.admin-card {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
  box-shadow:
    0 2rpx 8rpx rgba(197,160,89,0.08),
    0 6rpx 20rpx rgba(28,28,28,0.05);
  border: 1.5rpx solid rgba(197,160,89,0.1);
  position: relative;
  overflow: hidden;
}

/* 左侧光晕装饰 */
.admin-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  border-radius: 20rpx 0 0 20rpx;
}
.admin-card:first-child::before {
  background: linear-gradient(180deg, #D4B06A, #C5A059);
}
.admin-card:last-child::before {
  background: linear-gradient(180deg, #8EC4A0, #6BA88A);
}

/* 圆形图标徽章 */
.admin-card-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.badge-gold {
  background: linear-gradient(135deg, rgba(212,176,106,0.2) 0%, rgba(197,160,89,0.12) 100%);
}
.badge-sage {
  background: linear-gradient(135deg, rgba(142,196,160,0.2) 0%, rgba(107,168,138,0.12) 100%);
}

/* 三道杠 badge 内图标 */
.badge-bars {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  align-items: flex-start;
}
.badge-bar {
  width: 32rpx;
  height: 5rpx;
  background: #C5A059;
  border-radius: 4rpx;
}
.badge-bar.short {
  width: 22rpx;
  opacity: 0.65;
}

/* 套餐 badge 内图标 */
.badge-pkg {
  position: relative;
  width: 36rpx;
  height: 34rpx;
}
.pkg-rect {
  width: 32rpx;
  height: 26rpx;
  border: 3.5rpx solid #6BA88A;
  border-radius: 6rpx;
  position: absolute;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
}
.pkg-star {
  width: 14rpx;
  height: 14rpx;
  background: #6BA88A;
  border-radius: 50%;
  position: absolute;
  top: 0;
  right: 0;
  border: 2rpx solid #FFF;
}

/* 文字区 */
.admin-card-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}
.admin-card-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #1C1C1C;
  letter-spacing: 0.5px;
}
.admin-card-sub {
  font-size: 20rpx;
  color: #B0A89A;
  letter-spacing: 0.3px;
}

/* 右侧箭头 */
.admin-card-chevron {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #C5C0B8;
  border-top: 3rpx solid #C5C0B8;
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* ===== 搜索栏 ===== */
.search-wrap {
  padding: 16rpx 24rpx 12rpx;
  background: #FDFCF9;
  z-index: 10;
}
.search-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  height: 80rpx;
  border-radius: 40rpx;
  padding: 0 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(28,28,28,0.05);
  border: 1.5rpx solid rgba(28,28,28,0.06);
}

/* 搜索图标 纯CSS */
.icon-search {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.search-circle {
  width: 22rpx;
  height: 22rpx;
  border: 2.5rpx solid #B0A99A;
  border-radius: 50%;
  position: absolute;
  top: 0; left: 0;
}
.search-handle {
  width: 2.5rpx;
  height: 10rpx;
  background: #B0A99A;
  position: absolute;
  bottom: -2rpx; right: 2rpx;
  transform: rotate(-45deg);
  border-radius: 2rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1C1C1C;
}
.search-ph { color: #C0BBB4; }

/* 清除按钮 */
.clear-btn {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.clear-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #D4CFC9;
  position: relative;
}
.clear-icon::before,
.clear-icon::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 2rpx;
  background: #FFF;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(45deg);
}
.clear-icon::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* ===== 主体布局 ===== */
.content-body {
  flex: 1;
  display: flex;
  overflow: hidden;
  margin-top: 4rpx;
}

/* ===== 左侧分类栏 ===== */
.sidebar {
  width: 180rpx;
  height: 100%;
  background: rgba(238, 236, 232, 0.4);
  flex-shrink: 0;
}
.sidebar-item {
  position: relative;
  min-height: 100rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s, font-weight 0.2s;
}
.sidebar-item.active {
  background: #FDFCF9;
}
.active-bar {
  position: absolute;
  left: 0;
  top: 30rpx;
  bottom: 30rpx;
  width: 6rpx;
  background: #C5A059;
  border-radius: 0 6rpx 6rpx 0;
}
.sidebar-name {
  font-size: 26rpx;
  color: #8E877F;
  text-align: center;
  line-height: 1.4;
}
.sidebar-item.active .sidebar-name {
  color: #1C1C1C;
  font-weight: 700;
  font-size: 28rpx;
}

/* ===== 右侧商品区 ===== */
.main-content {
  flex: 1;
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

/* ===== 搜索提示 ===== */
.search-result-tip {
  padding: 20rpx 24rpx 10rpx;
  font-size: 24rpx;
  color: #B0A99A;
}

/* ===== 商品网格 ===== */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 24rpx;
}

.product-card {
  background: #FFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(28,28,28,0.04);
  border: 1px solid rgba(28,28,28,0.03);
  display: flex;
  flex-direction: column;
}

.product-img {
  width: 100%;
  height: 260rpx;
  background: #F8F6F2;
}

.product-info {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 26rpx;
  color: #1C1C1C;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  color: #C5A059;
  margin-top: auto;
}

.price-symbol {
  font-size: 20rpx;
  font-weight: 700;
}

.price-val {
  font-size: 32rpx;
  font-weight: 700;
  margin: 0 4rpx;
  letter-spacing: -0.5px;
}

.price-unit {
  font-size: 20rpx;
  color: #8E877F;
  margin-left: 2rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  gap: 16rpx;
}
.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 8rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #1C1C1C;
  font-weight: 500;
}
