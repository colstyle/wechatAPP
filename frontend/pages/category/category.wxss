/* pages/category/category.wxss */

.page-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FDFCF9;
  overflow: hidden;
}

/* ===== 搜索栏 ===== */
.search-wrap {
  padding: 16rpx 24rpx 12rpx;
  background: #FDFCF9;
  z-index: 10;
}
.search-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  height: 80rpx;
  border-radius: 40rpx;
  padding: 0 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(28,28,28,0.05);
  border: 1.5rpx solid rgba(28,28,28,0.06);
}

/* 搜索图标 纯CSS */
.icon-search {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.search-circle {
  width: 22rpx;
  height: 22rpx;
  border: 2.5rpx solid #B0A99A;
  border-radius: 50%;
  position: absolute;
  top: 0; left: 0;
}
.search-handle {
  width: 2.5rpx;
  height: 10rpx;
  background: #B0A99A;
  position: absolute;
  bottom: -2rpx; right: 2rpx;
  transform: rotate(-45deg);
  border-radius: 2rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1C1C1C;
}
.search-ph { color: #C0BBB4; }

/* 清除按钮 */
.clear-btn {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.clear-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #D4CFC9;
  position: relative;
}
.clear-icon::before,
.clear-icon::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 2rpx;
  background: #FFF;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(45deg);
}
.clear-icon::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* ===== 主体布局 ===== */
.content-body {
  flex: 1;
  display: flex;
  overflow: hidden;
  margin-top: 4rpx;
}

/* ===== 左侧分组栏 ===== */
.sidebar {
  width: 168rpx;
  height: 100%;
  background: rgba(238, 236, 232, 0.5);
  flex-shrink: 0;
}
.sidebar-item {
  position: relative;
  min-height: 112rpx;
  padding: 16rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: background 0.2s;
}
.sidebar-item.active {
  background: #FDFCF9;
}
.active-bar {
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  background: #C5A059;
  border-radius: 0 4rpx 4rpx 0;
}
.sidebar-emoji {
  font-size: 36rpx;
  line-height: 1;
}
.sidebar-name {
  font-size: 22rpx;
  color: #8E877F;
  text-align: center;
  line-height: 1.3;
}
.sidebar-item.active .sidebar-name {
  color: #1C1C1C;
  font-weight: 600;
}

/* ===== 右侧主内容 ===== */
.main-content {
  flex: 1;
  height: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

/* 分组标题 */
.group-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 24rpx 16rpx;
}
.group-emoji {
  font-size: 36rpx;
}
.group-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1C;
}

/* ===== 宫格 ===== */
.item-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 20rpx 40rpx;
}

.grid-item {
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(28,28,28,0.06);
}

.grid-item-inner {
  position: relative;
  padding: 32rpx 20rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  border-radius: 20rpx;
  min-height: 150rpx;
  border: 1rpx solid rgba(255,255,255,0.8);
}

/* 角标 */
.badge-wrap {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
}
.badge-text {
  font-size: 20rpx;
  color: #fff;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

/* 宫格图标 */
.grid-emoji {
  font-size: 52rpx;
  line-height: 1;
}

/* 宫格名称 */
.grid-name {
  font-size: 27rpx;
  color: #1C1C1C;
  font-weight: 600;
  line-height: 1.3;
}

/* 搜索时的分组提示 */
.grid-group-hint {
  font-size: 22rpx;
  color: #8E877F;
}

/* 箭头 */
.grid-arrow {
  position: absolute;
  right: 20rpx;
  bottom: 22rpx;
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid rgba(28,28,28,0.25);
  border-top: 3rpx solid rgba(28,28,28,0.25);
  transform: rotate(45deg);
}

/* ===== 搜索结果提示 ===== */
.search-result-tip {
  padding: 20rpx 24rpx 10rpx;
  font-size: 24rpx;
  color: #B0A99A;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
  gap: 12rpx;
}
.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 8rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #1C1C1C;
  font-weight: 500;
}
.empty-sub {
  font-size: 24rpx;
  color: #B0A99A;
}
