.page-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FDFCF9;
}

.top-hint {
  padding: 14rpx 24rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(28, 28, 28, 0.04);
}

.hint-text {
  font-size: 24rpx;
  color: #8E877F;
}

.hint-btn {
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  border: 1rpx solid #E7E2DA;
  font-size: 24rpx;
  color: #2E2B26;
}

.list {
  flex: 1;
  padding: 18rpx 18rpx 24rpx;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.load-footer {
  padding: 22rpx 0 8rpx;
  text-align: center;
}

.load-more-btn {
  font-size: 24rpx;
  color: #8E877F;
}

.no-more {
  font-size: 24rpx;
  color: #C0B9AF;
}

.loading-dots {
  display: inline-flex;
  gap: 8rpx;
  align-items: center;
  justify-content: center;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #C5A059;
  opacity: 0.6;
}
