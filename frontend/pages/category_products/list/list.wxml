<view class="page-root">
  <cp-nav-bar title="{{title}}" show-back="{{true}}" bg="white"></cp-nav-bar>

  <view class="top-hint" wx:if="{{selectedDate}}">
    <text class="hint-text">{{selectedDate}} 档期可用</text>
    <view class="hint-btn" bindtap="pickDate">
      <text>切换日期</text>
    </view>
  </view>

  <scroll-view class="list" scroll-y bindscrolltolower="onLoadMore">
    <view class="product-grid" wx:if="{{products.length > 0}}">
      <cp-product-card
        wx:for="{{products}}"
        wx:key="id"
        product="{{item}}"
        bindtap="onProductTap"
        data-id="{{item.id}}"
      ></cp-product-card>
    </view>

    <view class="empty-box" wx:if="{{!loading && products.length === 0}}">
      <cp-empty text="暂无商品" subText="该分类下暂无可租衣物"></cp-empty>
    </view>

    <view class="load-footer" wx:if="{{products.length > 0}}">
      <view class="loading-dots" wx:if="{{loading}}">
        <view class="dot"></view><view class="dot"></view><view class="dot"></view>
      </view>
      <text wx:elif="{{hasMore}}" class="load-more-btn" bindtap="onLoadMore">下滑加载更多</text>
      <text wx:else class="no-more">— 已为您展示全部内容 —</text>
    </view>
  </scroll-view>
</view>
